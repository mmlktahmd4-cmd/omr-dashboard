  _gt_cha=$(uci -q get glorytun-udp.vpn.chacha20); [ -z "$_gt_cha" ] && _gt_cha=$(uci -q get glorytun-udp.vpn.chacha)
  [ -z "$_gt_cha" ] && _gt_cha=1
  _gt_key=$(uci -q get glorytun-udp.vpn.key)
  _gt_key_set=false; [ -n "$_gt_key" ] && _gt_key_set=true

  _ss_dis=$(uci -q get shadowsocks-rust.sss0.disabled); [ -z "$_ss_dis" ] && _ss_dis=0
  _ss_host=$(uci -q get shadowsocks-rust.sss0.server)
