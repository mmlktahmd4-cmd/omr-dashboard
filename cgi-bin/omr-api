  printf '{'
  printf '"ok":true,'
  printf '"server":{"ip":"%s","username":"%s","port":"%s","token_set":%s},' \
    "$_vip" "$_vuser" "$_vport" "$([ -n "$_vtok" ] && echo true || echo false)"
  printf '"settings":{"vpn":"%s","proxy":"%s","master":"%s","lan_ip":"%s","lan_mask":"%s","bond_profile":"%s","mptcp_scheduler":"%s","mptcp_live":"%s","mptcp_available":"%s","keepalive":"%s","tracker_fail_interval":"%s","congestion":"%s","path_manager":"%s","subflows":"%s","force_multipath":"%s","checksum":"%s","nodelay":"%s","governor":"%s","disable_ipv6":"%s","mptcpovervpn":"%s"},' \
    "$_vpn" "$_proxy" "$_master" "$_lan_ip" "$_lan_mask" "$_profile" "$_sched" "$_sched_live" "$_avail" "$_ka" "$_ft" \
    "$_cong" "$_pm" "$_subf" "$_force" "$_csum" "$_nodelay" "$_gov" "$_dis6" "$_mptcpovpn"
  printf '"vpn":{"enable":"%s","host":"%s","port":"%s","dev":"%s","localip":"%s","remoteip":"%s","keepalive":"%s","chacha20":"%s","key_set":%s},' \
    "$_gt_en" "$_gt_host" "$_gt_port" "$_gt_dev" "$_gt_lip" "$_gt_rip" "$_ka" "$_gt_cha" "$_gt_key_set"
  printf '"proxy_cfg":{"disabled":"%s","server":"%s","port":"%s","method":"%s","key_set":%s,"rules_disabled":"%s","redir_tcp":"%s"},' \
    "$_ss_dis" "$_ss_host" "$_ss_port" "$_ss_method" "$_ss_key_set" "$_ss_rules_dis" "$_ss_redir"
  printf '"lan":{"proto":"%s","ip":"%s","netmask":"%s","gateway":"%s","device":"%s","dhcp_server":%s,"dhcp_start":"%s","dhcp_limit":"%s","dhcp_leasetime":"%s"},' \
    "$_lan_proto" "$_lan_ip" "$_lan_mask" "$_lan_gw" "$_lan_dev" "$_lan_dhcp_server" "$_dhcp_start" "$_dhcp_limit" "$_dhcp_leasetime"
  printf '"devices":[%s],' "$_devs"
  printf '"wans":[%s]' "$_wj"
  printf '}'
}

# ---------- bonding profiles ----------
set_bond() {
  PROF=$(qget profile); [ -z "$PROF" ] && PROF=smooth
  SCHED=$(qget scheduler)
  MASTER=$(qget master)
  KA=$(qget keepalive)
  FAILI=$(qget fail_interval)

  # apply profile defaults first, then honor explicit UI overrides
  case "$PROF" in
    smooth|redundant)
      # جدولة النواة المدمجة (default) هي الوحيدة المستقرة على هذه النواة؛
      # جدولات bpf_* تُسبّب تحذيرات/تعليق في MPTCP وتقطيع الإنترنت
      MASTER=balancing; SCHED=default; KA=10s; FAILI=5
      for _bw in $(list_wans); do
        uci set network."$_bw".multipath='on'
        uci set network."$_bw".auto='1'
        uci -q delete network."$_bw".disabled || true
        uci set openmptcprouter."$_bw".multipath='on'
      done
      PROF=smooth
      ;;
    speed)
      MASTER=balancing; SCHED=default; KA=10s; FAILI=5
      for _bw in $(list_wans); do
        uci set network."$_bw".multipath='on'
        uci set network."$_bw".auto='1'
        uci -q delete network."$_bw".disabled || true
        uci set openmptcprouter."$_bw".multipath='on'
      done
      ;;
    failover)
      MASTER=failover; SCHED=default; KA=10s; FAILI=5
      _bi=0
      for _bw in $(list_wans); do
        _bi=$((_bi+1))
        if [ "$_bi" = "1" ]; then
          uci set network."$_bw".multipath='master'
          uci set openmptcprouter."$_bw".multipath='master'
        else
          uci set network."$_bw".multipath='backup'
          uci set openmptcprouter."$_bw".multipath='backup'
        fi
        uci set network."$_bw".auto='1'
      done
      ;;
    custom)
      [ -z "$SCHED" ] && SCHED=$(uci -q get network.globals.mptcp_scheduler)
      [ -z "$MASTER" ] && MASTER=$(uci -q get openmptcprouter.settings.master)
      [ -z "$KA" ] && KA=$(uci -q get glorytun-udp.vpn.keepalive)
      [ -z "$FAILI" ] && FAILI=$(uci -q get omr-tracker.defaults.failure_interval)
      ;;
    *) err_json "unknown profile"; return ;;
  esac

  # UI overrides (editable fields)
  _os=$(qget scheduler); [ -n "$_os" ] && SCHED="$_os"
  _om=$(qget master); [ -n "$_om" ] && MASTER="$_om"
  _ok=$(qget keepalive); [ -n "$_ok" ] && KA="$_ok"
  _of=$(qget fail_interval); [ -n "$_of" ] && FAILI="$_of"
  [ -z "$SCHED" ] && SCHED=default
  [ -z "$MASTER" ] && MASTER=balancing
  [ -z "$KA" ] && KA=5s
  [ -z "$FAILI" ] && FAILI=2

  # validate scheduler against kernel (fallback without wiping override intent)
  _ok=0
  _avail=$(sysctl -n net.mptcp.available_schedulers 2>/dev/null)
  for s in $_avail; do
    [ "$s" = "$SCHED" ] && _ok=1
  done
  if [ "$_ok" = "0" ]; then
    case "$SCHED" in
      bpf_red|redundant) for s in $_avail; do case "$s" in bpf_red|redundant) SCHED=$s; _ok=1; break ;; esac; done ;;
      bpf_rr|roundrobin) for s in $_avail; do case "$s" in bpf_rr|roundrobin) SCHED=$s; _ok=1; break ;; esac; done ;;
      bpf_bkup|backup) for s in $_avail; do case "$s" in bpf_bkup|backup) SCHED=$s; _ok=1; break ;; esac; done ;;
    esac
  fi
  [ "$_ok" = "0" ] && SCHED=$(printf '%s' "$_avail" | awk '{print $1}')
  [ -z "$SCHED" ] && SCHED=default

  uci set openmptcprouter.settings.bond_profile="$PROF"
  uci set openmptcprouter.settings.master="$MASTER"
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set openmptcprouter.settings.vpn='glorytun_udp'
  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
  uci set network.globals.mptcp_scheduler="$SCHED"
  uci set network.globals.mptcp_path_manager='fullmesh'
  uci set network.globals.mptcp_force_multipath='1'
  uci set network.globals.multipath='enable'
  uci set network.globals.congestion='bbr'
  uci set network.globals.mptcp_checksum='0'
  uci set glorytun-udp.vpn.keepalive="$KA"
  uci set omr-tracker.defaults.failure_interval="$FAILI"
  uci set omr-tracker.defaults.timeout='3'
  uci set omr-tracker.defaults.interval='5'
  uci set omr-tracker.defaults.interval_tries='2'
  uci set omr-tracker.defaults.tries='3'
  uci set omr-tracker.defaults.tries_up='3'
  uci set omr-tracker.defaults.count='2'
  for _bw in $(list_wans); do
    uci set network."$_bw".peerdns='0'
    uci set network."$_bw".defaultroute='0'
  done

  CONG=$(qget congestion)
  SUBF=$(qget subflows)
  [ -n "$CONG" ] && uci set network.globals.congestion="$CONG"
  [ -n "$SUBF" ] && uci set network.globals.mptcp_subflows="$SUBF"

  # prefer IPv4 on SS redir (IPv6 stalls cause cut/lag)
  uci -q set shadowsocks-rust.hi1.ipv6_first='0'

  sysctl -w net.mptcp.scheduler="$SCHED" >/dev/null 2>&1 || true
  sysctl -w net.mptcp.stale_loss_cnt=2 >/dev/null 2>&1 || true
  # faster path recovery when a line drops (redundant / smooth)
  case "$SCHED" in
    bpf_red|redundant)
      sysctl -w net.mptcp.stale_loss_cnt=1 >/dev/null 2>&1 || true
      sysctl -w net.mptcp.blackhole_timeout=0 >/dev/null 2>&1 || true
      ;;
  esac
  CONF=/etc/sysctl.d/zzz_openmptcprouter.conf
  if [ -f "$CONF" ]; then
    grep -q '^net.mptcp.scheduler' "$CONF" \
      && sed -i "s/^net.mptcp.scheduler.*/net.mptcp.scheduler=$SCHED/" "$CONF" \
      || echo "net.mptcp.scheduler=$SCHED" >> "$CONF"
  fi

  uci commit openmptcprouter
  uci commit network
  uci commit glorytun-udp
  uci commit omr-tracker 2>/dev/null || uci commit
  /etc/init.d/omr-tracker restart >/dev/null 2>&1 || true
  /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true

  _red=false; case "$SCHED" in bpf_red|redundant) _red=true ;; esac
  ok_json setbond ",\"profile\":\"$PROF\",\"scheduler\":\"$SCHED\",\"master\":\"$MASTER\",\"keepalive\":\"$KA\",\"fail_interval\":\"$FAILI\",\"redundant\":$_red"
}

# ---------- set server + auto-fetch keys ----------
set_server() {
  HOST=$(qget host)
  TOKEN=$(qget token)
  [ -z "$TOKEN" ] && TOKEN=$(qget password)
  PORT=$(qget port); [ -z "$PORT" ] && PORT=65500
  USER=$(qget user); [ -z "$USER" ] && USER=openmptcprouter
  MODE=$(qget mode); [ -z "$MODE" ] && MODE=auto
  GTKEY_IN=$(qget gt_key)
  SSKEY_IN=$(qget ss_key)
  SSMETHOD_IN=$(qget ss_method)
  SSPORT_IN=$(qget ss_port)
  if [ -z "$HOST" ]; then err_json "host required"; return; fi
  case "$PORT" in
    22|65222)
      err_json "wrong port: use admin API 65500 (not SSH 22/65222)"
      return
      ;;
  esac
  PORT=65500

  if [ "$MODE" = "manual" ]; then
    if [ -z "$GTKEY_IN" ] || [ -z "$SSKEY_IN" ]; then
      err_json "manual mode needs Glorytun key + Shadowsocks password"
      return
    fi
  else
    if [ -z "$TOKEN" ]; then TOKEN=$(uci -q get openmptcprouter.vps.password); fi
    if [ -z "$TOKEN" ]; then err_json "username/password required (VPS admin key)"; return; fi
  fi

  uci -q delete openmptcprouter.vps.ip || true
  uci add_list openmptcprouter.vps.ip="$HOST"
  uci set openmptcprouter.vps.username="$USER"
  [ -n "$TOKEN" ] && uci set openmptcprouter.vps.password="$TOKEN"
  uci set openmptcprouter.vps.port="$PORT"
  uci set openmptcprouter.vps.get_config="$([ "$MODE" = "auto" ] && echo 1 || echo 0)"
  uci set openmptcprouter.vps.set_firewall='1'
  uci set openmptcprouter.vps.master='1'
  uci set openmptcprouter.vps.current='1'

  uci set openmptcprouter.settings.vpn='glorytun_udp'
  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set openmptcprouter.settings.disableserverping='0'

  uci set glorytun-udp.vpn.enable='1'
  uci set glorytun-udp.vpn.host="$HOST"
  uci set glorytun-udp.vpn.port='65001'
  uci set glorytun-udp.vpn.dev='tun0'

  uci set shadowsocks-rust.sss0.server="$HOST"
  uci set shadowsocks-rust.sss0.server_port="${SSPORT_IN:-65280}"
  uci -q set shadowsocks-rust.sss0.disabled='0'

  uci set network.omrvpn=interface
  uci set network.omrvpn.proto='static'
  uci set network.omrvpn.device='tun0'
  uci set network.omrvpn.ipaddr='10.255.254.2'
  uci set network.omrvpn.netmask='255.255.255.252'
  uci set network.omrvpn.gateway='10.255.254.1'
  uci set network.omrvpn.multipath='off'
  uci set network.omrvpn.metric='1500'
  uci set glorytun-udp.vpn.localip='10.255.254.2'
  uci set glorytun-udp.vpn.remoteip='10.255.254.1'

  KEYS_OK=0
  GT_OK=0
  SS_OK=0
  MSG=""

  if [ "$MODE" = "manual" ]; then
    uci set glorytun-udp.vpn.key="$GTKEY_IN"
    uci set glorytun-udp.vpn.chacha20='1'
    GT_OK=1
    uci set shadowsocks-rust.sss0.password="$SSKEY_IN"
    [ -n "$SSMETHOD_IN" ] && uci set shadowsocks-rust.sss0.method="$SSMETHOD_IN"
    [ -n "$SSPORT_IN" ] && uci set shadowsocks-rust.sss0.server_port="$SSPORT_IN"
    SS_OK=1
    KEYS_OK=1
    MSG="manual keys applied (no API fetch)"
  else
  # --- pull token + config from VPS admin API on 65500 (HTTPS then HTTP) ---
  CFG=/tmp/omr-vps-cfg.json
  TOKFILE=/tmp/omr-vps-tok.json
  rm -f "$CFG" "$TOKFILE"
  for SCHEME in https http; do
    BASE="$SCHEME://$HOST:$PORT"
    if command -v curl >/dev/null 2>&1; then
      curl -4 -sk -m 20 -X POST "$BASE/token" \
        --data-urlencode "username=$USER" \
        --data-urlencode "password=$TOKEN" > "$TOKFILE" 2>/dev/null || true
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$TOKFILE" --no-check-certificate -T 20 \
        --post-data="username=$USER&password=$TOKEN" "$BASE/token" 2>/dev/null || true
    fi
    ACCESS=$(sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TOKFILE" 2>/dev/null | head -1)
    [ -z "$ACCESS" ] && continue
    if command -v curl >/dev/null 2>&1; then
      curl -4 -sk -m 25 -H "Authorization: Bearer $ACCESS" "$BASE/config" > "$CFG" 2>/dev/null || true
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$CFG" --no-check-certificate -T 25 \
        --header="Authorization: Bearer $ACCESS" "$BASE/config" 2>/dev/null || true
    fi
    [ -s "$CFG" ] && grep -q '"glorytun"' "$CFG" 2>/dev/null && break
  done

  if [ -s "$CFG" ] && grep -q '"glorytun"' "$CFG" 2>/dev/null; then
    KEYS_OK=1
    GTKEY=$(jsonfilter -i "$CFG" -e '@.glorytun.key' 2>/dev/null)
    GTPORT=$(jsonfilter -i "$CFG" -e '@.glorytun.port' 2>/dev/null)
    GTPEER=$(jsonfilter -i "$CFG" -e '@.glorytun.udp.host_ip' 2>/dev/null)
    GTCHA=$(jsonfilter -i "$CFG" -e '@.glorytun.chacha' 2>/dev/null)
    if [ -n "$GTKEY" ]; then
      uci set glorytun-udp.vpn.key="$GTKEY"
      [ -n "$GTPORT" ] && uci set glorytun-udp.vpn.port="$GTPORT"
      [ -n "$GTPEER" ] && uci set glorytun-udp.vpn.remoteip="$GTPEER"
      if [ "$GTCHA" = "true" ] || [ "$GTCHA" = "1" ]; then
        uci set glorytun-udp.vpn.chacha20='1'
      fi
      GT_OK=1
    fi

    SSRKEY=$(jsonfilter -i "$CFG" -e '@.xray.config.sskey' 2>/dev/null)
    SSRMETHOD=$(jsonfilter -i "$CFG" -e '@.xray.config.ss_method' 2>/dev/null)
    SSPORT=$(jsonfilter -i "$CFG" -e '@.shadowsocks.port' 2>/dev/null)
    SSKEY=$(jsonfilter -i "$CFG" -e '@.shadowsocks.key' 2>/dev/null)
    SSMETHOD=$(jsonfilter -i "$CFG" -e '@.shadowsocks.method' 2>/dev/null)
    if [ -n "$SSRKEY" ]; then
      uci set shadowsocks-rust.sss0.password="$SSRKEY"
      [ -n "$SSRMETHOD" ] && uci set shadowsocks-rust.sss0.method="$SSRMETHOD"
      uci set shadowsocks-rust.sss0.server_port='65280'
      SS_OK=1
    elif [ -n "$SSKEY" ]; then
      uci set shadowsocks-rust.sss0.password="$SSKEY"
      [ -n "$SSMETHOD" ] && uci set shadowsocks-rust.sss0.method="$SSMETHOD"
      [ -n "$SSPORT" ] && uci set shadowsocks-rust.sss0.server_port="$SSPORT"
      SS_OK=1
    fi
    MSG="keys fetched via API :$PORT (not SSH)"
  else
    MSG="API :$PORT unreachable — login saved; will retry get_config"
  fi
  fi

  fix_ss_path "$HOST"
  uci commit openmptcprouter
  uci commit glorytun-udp
  uci commit shadowsocks-rust
  uci commit network

  /etc/init.d/openmptcprouter-vps restart >/dev/null 2>&1 || true
  /etc/init.d/openmptcprouter restart >/dev/null 2>&1 || true
  sleep 2
  /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
  sleep 1
  ip link set tun0 up 2>/dev/null || true
  ip addr flush dev tun0 2>/dev/null || true
  ip addr add 10.255.254.2/30 peer 10.255.254.1 dev tun0 2>/dev/null || true
  ifup omrvpn >/dev/null 2>&1 || true
  /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1 || true
  rm -f /tmp/omr-exit-cache

  ok_json setserver ",\"host\":\"$HOST\",\"port\":\"$PORT\",\"mode\":\"$MODE\",\"keys_ok\":$KEYS_OK,\"glorytun\":$GT_OK,\"shadowsocks\":$SS_OK,\"msg\":$(json_str "$MSG")"
}

# ---------- OTA update ----------
do_update() {
  SCRIPT=/tmp/omr-ota-install.sh
  LOGF=/tmp/omr-ota.log
  rm -f "$SCRIPT" "$LOGF"
  OLD="$LOCAL_VER"
  if ! ota_get "install.sh" > "$SCRIPT" 2>"$LOGF"; then
    err_json "download failed (VPS+GitHub)" ",\"log\":$(json_str "$(cat "$LOGF" 2>/dev/null)")"
    return
  fi
  if [ ! -s "$SCRIPT" ]; then
    err_json "empty install script"; return
  fi
  sed -i 's/\r$//' "$SCRIPT" 2>/dev/null || true
  chmod +x "$SCRIPT"
  # Prefer VPS mirror inside installer too
  export OMR_OTA_VPS="$OTA_VPS"
  sh "$SCRIPT" >"$LOGF" 2>&1
  RC=$?
  NEW=$(cat "$VER_FILE" 2>/dev/null | tr -d ' \r\n')
  [ -z "$NEW" ] && NEW="$OLD"
  if [ "$RC" -ne 0 ] && [ "$NEW" = "$OLD" ]; then
    err_json "update failed" ",\"version\":\"$NEW\",\"log\":$(json_str "$(tail -c 1500 "$LOGF" 2>/dev/null)")"
    return
  fi
  rm -rf /tmp/luci-* /tmp/luci-indexcache* 2>/dev/null || true
  /etc/init.d/uhttpd reload >/dev/null 2>&1 || true
  printf '{"ok":true,"a":"update","version":"%s","old":"%s","log":%s}' "$NEW" "$OLD" "$(json_str "$(tail -c 1200 "$LOGF" 2>/dev/null)")"
}

# ---------- set WAN / broadband ----------
set_wan() {
  DEV=$(qget dev)
  PROTO=$(qget proto)
  MP=$(qget multipath); [ -z "$MP" ] && MP=on
  EN=$(qget enable); [ -z "$EN" ] && EN=1
  IP=$(qget ip); MASK=$(qget netmask); GW=$(qget gateway); DNS=$(qget dns)
  PPUSER=$(qget username); PPPASS=$(qget password)
  if [ -z "$I" ]; then err_json "interface required (wan1/wan2)"; return; fi
  [ -z "$DEV" ] && DEV=$(uci -q get network."$I".device)
  if [ -z "$DEV" ]; then err_json "device required"; return; fi
  [ -z "$PROTO" ] && PROTO=$(uci -q get network."$I".proto)
  [ -z "$PROTO" ] && PROTO=dhcp

  N=$(printf '%s' "$I" | sed 's/wan//')
  MET=$((4 + N))
  IP6T=$((60 + MET))
  wan_dev_meta "$DEV"

  uci set network."$I"=interface
  uci set network."$I".device="$DEV"
  uci set network."$I".multipath="$MP"
  uci set network."$I".defaultroute='0'
  uci set network."$I".delegate='0'
  uci set network."$I".addlatency='0'
  uci set network."$I".peerdns='0'
  uci set network."$I".ipv6='0'
  uci set network."$I".metric="$MET"
  uci set network."$I".ip4table="$MET"
  uci set network."$I".ip6table="$IP6T"
  uci set network."$I".label="$I"
  [ -n "$_modalias" ] && uci set network."$I".modalias="$_modalias"
  [ -n "$_product" ] && uci set network."$I".product="$_product"

  uci set network."${I}_dev"=device
  uci set network."${I}_dev".name="$DEV"
  uci set network."${I}_dev".txqueuelen='1000'

  # clear previous proto-specific options
  uci -q delete network."$I".ipaddr
  uci -q delete network."$I".netmask
  uci -q delete network."$I".gateway
  uci -q delete network."$I".dns
  uci -q delete network."$I".username
  uci -q delete network."$I".password

  case "$PROTO" in
    static)
      uci set network."$I".proto='static'
      [ -n "$IP" ] && uci set network."$I".ipaddr="$IP"
      [ -n "$MASK" ] && uci set network."$I".netmask="$MASK"
      [ -n "$GW" ] && uci set network."$I".gateway="$GW"
      if [ -n "$DNS" ]; then
        uci -q delete network."$I".dns
        for d in $DNS; do uci add_list network."$I".dns="$d"; done
        uci set network."$I".peerdns='0'
      fi
      ;;
    pppoe)
      uci set network."$I".proto='pppoe'
      uci set network."$I".username="$PPUSER"
      uci set network."$I".password="$PPPASS"
      ;;
    *)
      uci set network."$I".proto='dhcp'
      ;;
  esac

  if [ "$EN" = "0" ]; then uci set network."$I".auto='0'
  else uci set network."$I".auto='1'; uci -q delete network."$I".disabled || true
  fi

  uci set openmptcprouter."$I"=interface
  uci set openmptcprouter."$I".multipath="$MP"
  uci set openmptcprouter."$I".metric="$MET"
  echo "$(uci -q get firewall.zone_wan.network)" | grep -qw "$I" || uci add_list firewall.zone_wan.network="$I"

  uci commit network
  uci commit openmptcprouter
  uci commit firewall
  /etc/init.d/firewall reload >/dev/null 2>&1 || true
  if [ "$EN" = "0" ]; then ifdown "$I" >/dev/null 2>&1 || true
  else ifdown "$I" >/dev/null 2>&1 || true; sleep 1; ifup "$I" >/dev/null 2>&1 || true
  fi
  ok_json setwan ',"i":"'"$I"'","dev":"'"$DEV"'","proto":"'"$PROTO"'","multipath":"'"$MP"'"'
}

add_wan_device() {
  DEV=$(qget dev)
  MP=$(qget multipath); [ -z "$MP" ] && MP=on
  if [ -z "$DEV" ]; then err_json "device required"; return; fi
  [ ! -d /sys/class/net/"$DEV" ] && { err_json "device not found"; return; }
  _asg=$(dev_assigned_wan "$DEV")
  if [ -n "$_asg" ]; then
    ok_json addwan ",\"i\":\"$_asg\",\"dev\":\"$DEV\",\"existed\":true"
    return
  fi
  I=$(next_wan_name)
  create_wan_basic "$I" "$DEV" "$MP"
  uci commit network
  uci commit openmptcprouter
  uci commit firewall
  /etc/init.d/firewall reload >/dev/null 2>&1 || true
  ubus call network reload >/dev/null 2>&1 || true
  ifup "$I" >/dev/null 2>&1 || true
  WANS=$(list_wans)
  ok_json addwan ",\"i\":\"$I\",\"dev\":\"$DEV\",\"existed\":false"
}

scan_wans_action() {
  rm -f /tmp/omr-wan-discover.ts
  discover_wans 1
  _added="${DISCOVERED_ADDED:-}"
  _arr=""
  for _pair in $_added; do
    _ni=${_pair%%:*}; _nd=${_pair#*:}
    [ -n "$_arr" ] && _arr="$_arr,"
    _arr="$_arr{\"i\":\"$_ni\",\"dev\":\"$_nd\"}"
  done
  printf '{"ok":true,"a":"scanwans","added":[%s],"wans":"%s"}' "$_arr" "$(echo $WANS | tr ' ' ',')"
}

# ---------- LAN (exit / client side) ----------
set_lan() {
  PROTO=$(qget proto); [ -z "$PROTO" ] && PROTO=static
  IP=$(qget ip)
  MASK=$(qget netmask); [ -z "$MASK" ] && MASK=255.255.255.0
  GW=$(qget gateway)
  DHCP_SRV=$(qget dhcp_server)
  DHCP_START=$(qget dhcp_start)
  DHCP_LIMIT=$(qget dhcp_limit)
  DHCP_LEASE=$(qget dhcp_leasetime)

  case "$PROTO" in
    dhcp)
      uci set network.lan.proto='dhcp'
      uci -q delete network.lan.ipaddr || true
      uci -q delete network.lan.netmask || true
      uci -q delete network.lan.gateway || true
      ;;
    static|*)
      PROTO=static
      case "$IP" in
        *.*.*.*) : ;;
        *) printf '{"ok":false,"error":"invalid lan ip"}'; return ;;
      esac
      uci set network.lan.proto='static'
      uci set network.lan.ipaddr="$IP"
      uci set network.lan.netmask="$MASK"
      if [ -n "$GW" ]; then uci set network.lan.gateway="$GW"
      else uci -q delete network.lan.gateway || true; fi
      ;;
  esac

  # DHCP server for LAN clients (dnsmasq) — independent of lan.proto
  if [ "$DHCP_SRV" = "0" ] || [ "$DHCP_SRV" = "false" ] || [ "$DHCP_SRV" = "off" ]; then
    uci set dhcp.lan.ignore='1'
  else
    uci -q delete dhcp.lan.ignore || true
    [ -n "$DHCP_START" ] && uci set dhcp.lan.start="$DHCP_START"
    [ -n "$DHCP_LIMIT" ] && uci set dhcp.lan.limit="$DHCP_LIMIT"
    [ -n "$DHCP_LEASE" ] && uci set dhcp.lan.leasetime="$DHCP_LEASE"
  fi

  uci commit network
  uci commit dhcp
  (sleep 1; /etc/init.d/network restart; /etc/init.d/dnsmasq restart) >/dev/null 2>&1 &
  ok_json setlan ',"proto":"'"$PROTO"'","ip":"'"$IP"'","lan_changed":1'
}

# ---------- VPN (Glorytun UDP — VPS compatible) ----------
set_vpn() {
  EN=$(qget enable); [ -z "$EN" ] && EN=1
  PORT=$(qget port); [ -z "$PORT" ] && PORT=$(uci -q get glorytun-udp.vpn.port); [ -z "$PORT" ] && PORT=65001
  KA=$(qget keepalive); [ -z "$KA" ] && KA=$(uci -q get glorytun-udp.vpn.keepalive); [ -z "$KA" ] && KA=5s
  CHA=$(qget chacha20); [ -z "$CHA" ] && CHA=1
  LIP=$(qget localip); [ -z "$LIP" ] && LIP=$(uci -q get glorytun-udp.vpn.localip); [ -z "$LIP" ] && LIP=10.255.254.2
  RIP=$(qget remoteip); [ -z "$RIP" ] && RIP=$(uci -q get glorytun-udp.vpn.remoteip); [ -z "$RIP" ] && RIP=10.255.254.1
  HOST=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
  [ -z "$HOST" ] && HOST=$(uci -q get glorytun-udp.vpn.host)
  [ -z "$HOST" ] && { err_json "اربط السيرفر أولاً"; return; }

  uci set openmptcprouter.settings.vpn='glorytun_udp'
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set glorytun-udp.vpn.enable="$EN"
  uci set glorytun-udp.vpn.host="$HOST"
  uci set glorytun-udp.vpn.port="$PORT"
  uci set glorytun-udp.vpn.dev='tun0'
  uci set glorytun-udp.vpn.keepalive="$KA"
  uci set glorytun-udp.vpn.chacha20="$CHA"
  uci set glorytun-udp.vpn.chacha="$CHA"
  uci set glorytun-udp.vpn.localip="$LIP"
  uci set glorytun-udp.vpn.remoteip="$RIP"
  uci set glorytun-udp.vpn.mode='to'

  uci set network.omrvpn=interface
  uci set network.omrvpn.proto='static'
  uci set network.omrvpn.device='tun0'
  uci set network.omrvpn.ipaddr="$LIP"
  uci set network.omrvpn.netmask='255.255.255.252'
  uci set network.omrvpn.gateway="$RIP"
  uci set network.omrvpn.multipath='off'
  uci set network.omrvpn.metric='1500'

  uci commit glorytun-udp
  uci commit network
  uci commit openmptcprouter
  if [ "$EN" = "0" ]; then
    /etc/init.d/glorytun-udp stop >/dev/null 2>&1 || true
    ifdown omrvpn >/dev/null 2>&1 || true
  else
    /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
    sleep 1
    ip link set tun0 up 2>/dev/null || true
    ip addr flush dev tun0 2>/dev/null || true
    ip addr add "$LIP/30" peer "$RIP" dev tun0 2>/dev/null || ip addr add "$LIP/30" dev tun0 2>/dev/null || true
    ifup omrvpn >/dev/null 2>&1 || true
  fi
  ok_json setvpn ",\"enable\":\"$EN\",\"host\":\"$HOST\",\"port\":\"$PORT\",\"keepalive\":\"$KA\""
}

# ---------- Proxy (Shadowsocks-Rust — VPS compatible) ----------
set_proxy_cfg() {
  EN=$(qget enable); [ -z "$EN" ] && EN=1
  PORT=$(qget port); [ -z "$PORT" ] && PORT=$(uci -q get shadowsocks-rust.sss0.server_port); [ -z "$PORT" ] && PORT=65280
  METHOD=$(qget method); [ -z "$METHOD" ] && METHOD=$(uci -q get shadowsocks-rust.sss0.method)
  [ -z "$METHOD" ] && METHOD='2022-blake3-aes-256-gcm'
  PASS=$(qget password)
  HOST=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
  [ -z "$HOST" ] && HOST=$(uci -q get shadowsocks-rust.sss0.server)
  [ -z "$HOST" ] && { err_json "اربط السيرفر أولاً"; return; }

  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
  uci set shadowsocks-rust.sss0=server
  uci set shadowsocks-rust.sss0.server="$HOST"
  uci set shadowsocks-rust.sss0.server_port="$PORT"
  uci set shadowsocks-rust.sss0.method="$METHOD"
  if [ -n "$PASS" ]; then
    uci set shadowsocks-rust.sss0.password="$PASS"
  fi
  if [ "$EN" = "0" ]; then
