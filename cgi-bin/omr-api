#!/bin/sh
# OMR Connect API — status + real setup actions (LAN only)
printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-cache, no-store\r\n'
printf 'Access-Control-Allow-Origin: *\r\n'
printf '\r\n'

qget() {
  printf '%s' "$QUERY_STRING" | sed -n "s/.*\(^\|&\)$1=\([^&]*\).*/\2/p" | head -1 | sed 's/+/ /g' | sed 's/%3A/:/gi;s/%2F/\//gi;s/%40/@/gi;s/%3D/=/gi;s/%2B/+/gi;s/%20/ /g'
}

A=$(qget a); [ -z "$A" ] && A=status
# merge POST body into query for forms
if [ "$REQUEST_METHOD" = "POST" ]; then
  _cl=${CONTENT_LENGTH:-0}
  if [ "$_cl" -gt 0 ] 2>/dev/null; then
    _post=$(dd bs=1 count="$_cl" 2>/dev/null)
    QUERY_STRING="${QUERY_STRING}&${_post}"
    A=$(qget a); [ -z "$A" ] && A=status
  fi
fi
I=$(qget i)
case "$I" in wan[0-9]|wan[0-9][0-9]) : ;; *) I="" ;; esac

list_wans() {
  uci -q show network | sed -n 's/^network\.\(wan[0-9][0-9]*\)=interface$/\1/p' | sort -V
}
WANS=$(list_wans)
# fallback to ubus if uci empty
[ -z "$WANS" ] && WANS=$(ubus list 2>/dev/null | sed -n 's#^network\.interface\.\(wan[0-9]*\)$#\1#p')

VPS_HOST=$(uci -q get glorytun-udp.vpn.host)
[ -z "$VPS_HOST" ] && VPS_HOST=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
TUN_DEV=$(uci -q get glorytun-udp.vpn.dev); [ -z "$TUN_DEV" ] && TUN_DEV=tun0
TUN_PEER=$(uci -q get glorytun-udp.vpn.remoteip); [ -z "$TUN_PEER" ] && TUN_PEER=10.255.254.1

OTA_GITHUB="https://raw.githubusercontent.com/mmlktahmd4-cmd/omr-dashboard/main"
OTA_VPS="http://191.218.161.141:8088"
OTA_JSDELIVR="https://cdn.jsdelivr.net/gh/mmlktahmd4-cmd/omr-dashboard@main"
VER_FILE="/www/omr-dash/VERSION"
LOCAL_VER=$(cat "$VER_FILE" 2>/dev/null | tr -d ' \r\n'); [ -z "$LOCAL_VER" ] && LOCAL_VER="0"

fetch() {
  if command -v curl >/dev/null 2>&1; then curl -4 -fsSL -m 20 "$1"
  else uclient-fetch -q -T 20 -O - "$1"; fi
}
# نجلب من GitHub أولاً (المصدر الأحدث)، ثم jsDelivr، ثم مِرآة الـVPS كملاذ أخير.
# مِرآة الـVPS قد تتأخّر في المزامنة فنجعلها آخر خيار حتى لا نجلب نسخة قديمة.
ota_get() {
  # $1 = relative path e.g. VERSION or install.sh
  _rel="$1"
  for _base in "$OTA_GITHUB" "$OTA_JSDELIVR" "$OTA_VPS"; do
    if fetch "$_base/$_rel" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}
fetch_insecure() {
  if command -v curl >/dev/null 2>&1; then curl -fskL -m 20 "$@"
  elif command -v wget >/dev/null 2>&1; then wget -qO- --no-check-certificate -T 20 "$@"
  else return 1; fi
}
json_str() {
  printf '"'
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' '\001' | sed 's/\001/\\n/g'
  printf '"'
}
ping_ms() {
  _o=$(ping -c1 -W2 ${2:+-I "$2"} "$1" 2>/dev/null)
  printf '%s' "$_o" | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1
}
ok_json() { printf '{"ok":true,"a":"%s"%s}' "$1" "${2:-}"; }
err_json() { printf '{"ok":false,"error":%s%s}' "$(json_str "$1")" "${2:-}"; }

# Fix Shadowsocks path: LAN clients must use sss0 (VPS IP), never broken mptcpovervpn 10.255.247.1
fix_ss_path() {
  _ssh="$1"
  [ -z "$_ssh" ] && _ssh=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
  [ -z "$_ssh" ] && _ssh=$(uci -q get glorytun-udp.vpn.host)
  [ -n "$_ssh" ] && uci set shadowsocks-rust.sss0.server="$_ssh"
  uci set shadowsocks-rust.sss0.disabled='0'
  uci -q set shadowsocks-rust.sss0.server_port="$(uci -q get shadowsocks-rust.sss0.server_port)"
  [ -z "$(uci -q get shadowsocks-rust.sss0.server_port)" ] && uci set shadowsocks-rust.sss0.server_port='65280'
  # disable broken over-vpn internal endpoint
  uci -q set shadowsocks-rust.mptcpovervpn.disabled='1'
  uci -q set shadowsocks-rust.hivpn.disabled='1'
  uci -q set shadowsocks-rust.hi2.disabled='1'
  # enable working redir for nft redirect :1101
  uci set shadowsocks-rust.hi1=ss_redir
  uci set shadowsocks-rust.hi1.server='sss0'
  uci set shadowsocks-rust.hi1.local_address='0.0.0.0'
  uci set shadowsocks-rust.hi1.local_port='1101'
  uci set shadowsocks-rust.hi1.mode='tcp_and_udp'
  uci set shadowsocks-rust.hi1.disabled='0'
  uci set shadowsocks-rust.ss_rules.disabled='0'
  uci set shadowsocks-rust.ss_rules.server='sss0'
  uci set shadowsocks-rust.ss_rules.redir_tcp='all'
  uci set shadowsocks-rust.ss_rules.src_default='forward'
  uci set shadowsocks-rust.ss_rules.dst_default='forward'
  uci set shadowsocks-rust.ss_rules.local_default='forward'
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
}

# ---------- WAN discovery (new USB/eth → wanN with OMR basic path) ----------
lan_device() {
  _ld=$(uci -q get network.lan.device)
  [ -z "$_ld" ] && _ld=$(uci -q get network.lan.ifname | awk '{print $1}')
  [ -z "$_ld" ] && _ld=eth0
  printf '%s' "$_ld"
}

next_wan_name() {
  _n=1
  while uci -q get "network.wan${_n}" >/dev/null 2>&1; do _n=$((_n + 1)); done
  printf 'wan%s' "$_n"
}

wan_dev_meta() {
  # $1=netdev → sets _mac _modalias _product
  _dn="$1"
  _mac=$(cat /sys/class/net/"$_dn"/address 2>/dev/null | tr -d '\n')
  _modalias=""
  _product=""
  if [ -f /sys/class/net/"$_dn"/device/uevent ]; then
    _ma=$(sed -n 's/^MODALIAS=//p' /sys/class/net/"$_dn"/device/uevent 2>/dev/null | head -1 | tr -d '\n')
    [ -n "$_ma" ] && [ -n "$_mac" ] && _modalias="${_ma}-${_mac}"
    _vid=$(cat /sys/class/net/"$_dn"/device/../idVendor 2>/dev/null | tr -d '\n')
    _pid=$(cat /sys/class/net/"$_dn"/device/../idProduct 2>/dev/null | tr -d '\n')
    _bcd=$(cat /sys/class/net/"$_dn"/device/../bcdDevice 2>/dev/null | tr -d '\n')
    [ -n "$_vid" ] && [ -n "$_pid" ] && _product="${_vid}/${_pid}/${_bcd}"
  fi
}

create_wan_basic() {
  # $1=wanName $2=device $3=multipath(default on)
  _wi="$1"; _wd="$2"; _wmp="${3:-on}"
  _wn=$(printf '%s' "$_wi" | sed 's/wan//')
  _wmet=$((4 + _wn))
  _wip6=$((60 + _wmet))
  wan_dev_meta "$_wd"

  uci set network."$_wi"=interface
  uci set network."$_wi".device="$_wd"
  uci set network."$_wi".proto='dhcp'
  uci set network."$_wi".multipath="$_wmp"
  uci set network."$_wi".defaultroute='0'
  uci set network."$_wi".delegate='0'
  uci set network."$_wi".addlatency='0'
  uci set network."$_wi".metric="$_wmet"
  uci set network."$_wi".ip4table="$_wmet"
  uci set network."$_wi".ip6table="$_wip6"
  uci set network."$_wi".peerdns='0'
  uci set network."$_wi".label="$_wi"
  uci set network."$_wi".ipv6='0'
  uci set network."$_wi".auto='1'
  uci -q delete network."$_wi".disabled || true
  [ -n "$_modalias" ] && uci set network."$_wi".modalias="$_modalias"
  [ -n "$_product" ] && uci set network."$_wi".product="$_product"

  uci set network."${_wi}_dev"=device
  uci set network."${_wi}_dev".name="$_wd"
  uci set network."${_wi}_dev".txqueuelen='1000'

  uci set openmptcprouter."$_wi"=interface
  uci set openmptcprouter."$_wi".multipath="$_wmp"
  uci set openmptcprouter."$_wi".metric="$_wmet"
  uci set openmptcprouter."$_wi".multipathvpn='0'

  echo "$(uci -q get firewall.zone_wan.network)" | grep -qw "$_wi" || \
    uci add_list firewall.zone_wan.network="$_wi"
}

ensure_wan_path() {
  # fix incomplete existing WAN to OMR basic path (keep proto/device/multipath)
  _wi="$1"
  _wd=$(uci -q get network."$_wi".device)
  [ -z "$_wd" ] && return 1
  _wn=$(printf '%s' "$_wi" | sed 's/wan//')
  _wmet=$(uci -q get network."$_wi".metric)
  [ -z "$_wmet" ] && _wmet=$((4 + _wn))
  _wip6=$(uci -q get network."$_wi".ip6table)
  [ -z "$_wip6" ] && _wip6=$((60 + _wmet))
  _wmp=$(uci -q get network."$_wi".multipath); [ -z "$_wmp" ] && _wmp=on

  uci set network."$_wi".multipath="$_wmp"
  uci set network."$_wi".defaultroute='0'
  uci set network."$_wi".delegate='0'
  uci -q get network."$_wi".addlatency >/dev/null 2>&1 || uci set network."$_wi".addlatency='0'
  uci set network."$_wi".metric="$_wmet"
  uci set network."$_wi".ip4table="$_wmet"
  uci set network."$_wi".ip6table="$_wip6"
  uci -q get network."$_wi".label >/dev/null 2>&1 || uci set network."$_wi".label="$_wi"
  uci -q get network."$_wi".ipv6 >/dev/null 2>&1 || uci set network."$_wi".ipv6='0'

  if ! uci -q get network."${_wi}_dev" >/dev/null 2>&1; then
    uci set network."${_wi}_dev"=device
    uci set network."${_wi}_dev".name="$_wd"
    uci set network."${_wi}_dev".txqueuelen='1000'
  fi
  uci set openmptcprouter."$_wi"=interface
  uci set openmptcprouter."$_wi".multipath="$_wmp"
  uci set openmptcprouter."$_wi".metric="$_wmet"
  echo "$(uci -q get firewall.zone_wan.network)" | grep -qw "$_wi" || \
    uci add_list firewall.zone_wan.network="$_wi"
  return 0
}

discover_wans() {
  # $1=force(1) — scan physical NICs, create missing wanN, fix paths
  _force="${1:-0}"
  _stamp=/tmp/omr-wan-discover.ts
  _now=$(date +%s)
  if [ "$_force" != "1" ] && [ -f "$_stamp" ]; then
    _old=$(cat "$_stamp" 2>/dev/null)
    [ -n "$_old" ] && [ $((_now - _old)) -lt 15 ] 2>/dev/null && {
      DISCOVERED_ADDED=""
      return 0
    }
  fi
  echo "$_now" > "$_stamp"

  _land=$(lan_device)
  _used="$_land $(uci -q get network.omrvpn.device) $TUN_DEV"
  for _w in $(list_wans); do
    _used="$_used $(uci -q get network.$_w.device)"
  done

  DISCOVERED_ADDED=""
  _changed=0

  for _w in $(list_wans); do
    _need=0
    [ -z "$(uci -q get network.$_w.metric)" ] && _need=1
    [ -z "$(uci -q get network.$_w.ip4table)" ] && _need=1
    [ -z "$(uci -q get network.$_w.multipath)" ] && _need=1
    ! uci -q get network."${_w}_dev" >/dev/null 2>&1 && _need=1
    if [ "$_need" = "1" ]; then
      ensure_wan_path "$_w"
      _changed=1
    fi
  done

  for _d in $(ls /sys/class/net 2>/dev/null); do
    case "$_d" in
      lo|tun*|wg*|ifb*|sit*|gre*|teql*|ip6*|erspan*|br-*|wlan*|docker*|veth*|bonding_masters|dummy*|ap*|wwan*) continue ;;
    esac
    _type=$(cat /sys/class/net/"$_d"/type 2>/dev/null)
    [ "$_type" = "1" ] || continue

    _skip=0
    for _u in $_used; do
      [ -n "$_u" ] && [ "$_u" = "$_d" ] && _skip=1 && break
    done
    [ "$_skip" = "1" ] && continue

    _wi=$(next_wan_name)
    create_wan_basic "$_wi" "$_d" "on"
    DISCOVERED_ADDED="${DISCOVERED_ADDED} ${_wi}:${_d}"
    _used="$_used $_d"
    _changed=1
  done

  DISCOVERED_ADDED=$(printf '%s' "$DISCOVERED_ADDED" | sed 's/^ //')
  if [ "$_changed" = "1" ]; then
    uci commit network
    uci commit openmptcprouter
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1 || true
    ubus call network reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1 || true
    for _pair in $DISCOVERED_ADDED; do
      _ni=${_pair%%:*}
      [ -n "$_ni" ] && ifup "$_ni" >/dev/null 2>&1 || true
    done
    echo "$DISCOVERED_ADDED" > /tmp/omr-wan-added
    logger -t omr-connect "discovered WANs: ${DISCOVERED_ADDED:-path-fix}"
  fi
  WANS=$(list_wans)
}

dev_assigned_wan() {
  _dn="$1"
  for _w in $(list_wans); do
    [ "$(uci -q get network.$_w.device)" = "$_dn" ] && { printf '%s' "$_w"; return 0; }
  done
  [ "$(lan_device)" = "$_dn" ] && { printf 'lan'; return 0; }
  printf ''
}

# ---------- device specs (hardware) ----------
sysinfo_json() {
  _board=$(ubus call system board 2>/dev/null)
  _model=$(printf '%s' "$_board" | sed -n 's/.*"model": *"\([^"]*\)".*/\1/p' | head -1)
  [ -z "$_model" ] && _model=$(cat /tmp/sysinfo/model 2>/dev/null)
  _kernel=$(printf '%s' "$_board" | sed -n 's/.*"kernel": *"\([^"]*\)".*/\1/p' | head -1)
  [ -z "$_kernel" ] && _kernel=$(uname -r)
  _osrel=$(printf '%s' "$_board" | sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' | head -1)
  [ -z "$_osrel" ] && _osrel=$( (. /etc/openwrt_release 2>/dev/null; printf '%s' "$DISTRIB_DESCRIPTION") )
  _arch=$(uname -m)
  _host=$(uci -q get system.@system[0].hostname); [ -z "$_host" ] && _host=$(cat /proc/sys/kernel/hostname 2>/dev/null)

  _cpu=$(sed -n 's/^model name[[:space:]]*: *//p' /proc/cpuinfo | head -1)
  [ -z "$_cpu" ] && _cpu=$(sed -n 's/^system type[[:space:]]*: *//p' /proc/cpuinfo | head -1)
  [ -z "$_cpu" ] && _cpu=$(sed -n 's/^cpu model[[:space:]]*: *//p' /proc/cpuinfo | head -1)
  _cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null); [ -z "$_cores" ] || [ "$_cores" = "0" ] && _cores=1
  _mhz=$(sed -n 's/^cpu MHz[[:space:]]*: *\([0-9]*\).*/\1/p' /proc/cpuinfo | head -1)

  _load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)
  _up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1); [ -z "$_up" ] && _up=0

  _memt=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
  _mema=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
  [ -z "$_mema" ] && _mema=$(sed -n 's/^MemFree:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
  _memt=${_memt:-0}; _mema=${_mema:-0}; _memu=$((_memt-_mema))

  _dfline=$(df -k / 2>/dev/null | awk 'NR==2{print $2" "$3" "$4}')
  _dtot=$(printf '%s' "$_dfline" | awk '{print $1}'); _dused=$(printf '%s' "$_dfline" | awk '{print $2}'); _dfree=$(printf '%s' "$_dfline" | awk '{print $3}')
  _dtot=${_dtot:-0}; _dused=${_dused:-0}; _dfree=${_dfree:-0}

  _temp=""
  for _tz in /sys/class/thermal/thermal_zone*/temp; do
    [ -f "$_tz" ] || continue
    _tv=$(cat "$_tz" 2>/dev/null)
    case "$_tv" in ''|*[!0-9]*) : ;; *) _temp=$((_tv/1000)); break ;; esac
  done

  _sched=$(sysctl -n net.mptcp.scheduler 2>/dev/null)
  _mptcp_en=$(sysctl -n net.mptcp.enabled 2>/dev/null)
  _nwan=$(printf '%s\n' $WANS | grep -c . 2>/dev/null); [ -z "$_nwan" ] && _nwan=0
  _ndev=$(ls /sys/class/net 2>/dev/null | grep -Ec '^(eth|usb|wwan|wlan)'); [ -z "$_ndev" ] && _ndev=0

  printf '{"ok":true,'
  printf '"model":%s,' "$(json_str "$_model")"
  printf '"host":%s,' "$(json_str "$_host")"
  printf '"os":%s,' "$(json_str "$_osrel")"
  printf '"kernel":%s,' "$(json_str "$_kernel")"
  printf '"arch":%s,' "$(json_str "$_arch")"
  printf '"cpu":%s,' "$(json_str "$_cpu")"
  printf '"cores":%s,' "${_cores:-1}"
  printf '"mhz":"%s",' "$_mhz"
  printf '"load":"%s",' "$_load"
  printf '"uptime":%s,' "${_up:-0}"
  printf '"mem_total":%s,"mem_used":%s,"mem_avail":%s,' "$_memt" "$_memu" "$_mema"
  printf '"disk_total":%s,"disk_used":%s,"disk_free":%s,' "$_dtot" "$_dused" "$_dfree"
  printf '"temp":"%s",' "$_temp"
  printf '"scheduler":%s,' "$(json_str "$_sched")"
  printf '"mptcp":"%s",' "$_mptcp_en"
  printf '"wan_count":%s,"dev_count":%s,' "${_nwan:-0}" "${_ndev:-0}"
  printf '"dash_version":%s' "$(json_str "$LOCAL_VER")"
  printf '}'
}

# ---------- status ----------
status_json() {
  discover_wans 0
  WANS=$(list_wans)
  _wj=""
  _mp_ready=0; _net_ready=0; _mp_online=0
  for w in $WANS; do
    _st=$(ubus call network.interface."$w" status 2>/dev/null)
    _up=$(printf '%s' "$_st" | jsonfilter -e '@.up' 2>/dev/null)
    _dev=$(printf '%s' "$_st" | jsonfilter -e '@.l3_device' 2>/dev/null)
    [ -z "$_dev" ] && _dev=$(printf '%s' "$_st" | jsonfilter -e '@.device' 2>/dev/null)
    [ -z "$_dev" ] && _dev=$(uci -q get network."$w".device)
    _ip=$(printf '%s' "$_st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
    _proto=$(printf '%s' "$_st" | jsonfilter -e '@.proto' 2>/dev/null)
    _gw=$(printf '%s' "$_st" | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
    [ -z "$_gw" ] && _gw=$(printf '%s' "$_st" | jsonfilter -e '@.inactive.route[0].nexthop' 2>/dev/null)
    [ -z "$_gw" ] && _gw=$(uci -q get network."$w".gateway)
    _mp=$(uci -q get network."$w".multipath)
    _link=false; _speed=""
    # للكشف عن الرابط: واجهات PPPoE افتراضية (pppoe-wanX) لا يفهمها ethtool،
    # لذا نفحص الجهاز الفيزيائي الأساسي (ethX) الذي يعمل فوقه PPPoE
    _pdev="$_dev"
    case "$_proto" in
      pppoe|pppoa|ppp) _pdev=$(uci -q get network."$w".device); [ -z "$_pdev" ] && _pdev="$_dev" ;;
    esac
    if [ -n "$_pdev" ]; then
      _et=$(ethtool "$_pdev" 2>/dev/null)
      if printf '%s' "$_et" | grep -q "Link detected: yes"; then
        _link=true
      elif [ -f /sys/class/net/"$_pdev"/carrier ] && [ "$(cat /sys/class/net/"$_pdev"/carrier 2>/dev/null)" = "1" ]; then
        _link=true
      fi
      _speed=$(printf '%s' "$_et" | sed -n 's/.*Speed: \([0-9]*\)Mb\/s/\1/p' | head -1)
    fi
    # PPP وأي واجهة نقطة-لنقطة: نجاح الاتصال (up) يعني أن الرابط فعّال فعلاً
    case "$_proto" in
      pppoe|pppoa|ppp) [ "$_up" = "true" ] && _link=true ;;
    esac

    # bandwidth: compare with previous sample
    _rxr=0; _txr=0; _rxb=0; _txb=0
    if [ -n "$_dev" ] && [ -f "/sys/class/net/$_dev/statistics/rx_bytes" ]; then
      _rxb=$(cat /sys/class/net/"$_dev"/statistics/rx_bytes 2>/dev/null)
      _txb=$(cat /sys/class/net/"$_dev"/statistics/tx_bytes 2>/dev/null)
      _now=$(date +%s)
      _f="/tmp/omr-bw-$_dev"
      if [ -f "$_f" ]; then
        read _prx _ptx _pt < "$_f"
        _dt=$((_now - _pt))
        if [ "$_dt" -gt 0 ] 2>/dev/null; then
          _rxr=$(( (_rxb - _prx) * 8 / _dt ))
          _txr=$(( (_txb - _ptx) * 8 / _dt ))
          [ "$_rxr" -lt 0 ] && _rxr=0
          [ "$_txr" -lt 0 ] && _txr=0
        fi
      fi
      echo "$_rxb $_txb $_now" > "$_f"
    fi

    _net=false; _lat=""; _gwlat=""
    if [ "$_up" = "true" ] && [ -n "$_dev" ] && [ "$_link" = "true" ]; then
      _lat=$(ping_ms 1.1.1.1 "$_dev")
      # إعادة محاولة واحدة قبل اعتبار الخط بلا إنترنت (تسامح مع فقدان نبضة على مسار مرتفع الزمن)
      [ -z "$_lat" ] && _lat=$(ping_ms 1.1.1.1 "$_dev")
      [ -n "$_lat" ] && _net=true
      [ -n "$_gw" ] && _gwlat=$(ping_ms "$_gw" "$_dev")
    fi
    [ -z "$_up" ] && _up=false
    case "$_mp" in on|master|backup) _mp_ready=$((_mp_ready+1)) ;; esac
    [ "$_net" = "true" ] && _net_ready=$((_net_ready+1))
    case "$_mp" in on|master|backup) [ "$_net" = "true" ] && _mp_online=$((_mp_online+1)) ;; esac
    [ -n "$_wj" ] && _wj="$_wj,"
    _wj="$_wj{\"name\":\"$w\",\"up\":$_up,\"dev\":\"$_dev\",\"ip\":\"$_ip\",\"proto\":\"$_proto\",\"gateway\":\"$_gw\",\"multipath\":\"$_mp\",\"link\":$_link,\"speed\":\"$_speed\",\"net\":$_net,\"lat\":\"$_lat\",\"gw_lat\":\"$_gwlat\",\"rx_bps\":$_rxr,\"tx_bps\":$_txr,\"rx_bytes\":$_rxb,\"tx_bytes\":$_txb}"
  done

  _tunup=false; _tl=""; _tunip=""
  if ip link show "$TUN_DEV" >/dev/null 2>&1; then
    _tunip=$(ip -4 -o addr show "$TUN_DEV" 2>/dev/null | awk '{print $4}' | head -1)
    if [ -z "$_tunip" ] && pgrep -f glorytun-udp >/dev/null 2>&1; then
      _lip=$(uci -q get glorytun-udp.vpn.localip); [ -z "$_lip" ] && _lip=10.255.254.2
      ip addr add "$_lip/30" peer "$TUN_PEER" dev "$TUN_DEV" 2>/dev/null || \
        ip addr add "$_lip/30" dev "$TUN_DEV" 2>/dev/null || true
      _tunip=$(ip -4 -o addr show "$TUN_DEV" 2>/dev/null | awk '{print $4}' | head -1)
    fi
    _tl=$(ping_ms "$TUN_PEER")
    # إعادة محاولة واحدة قبل الحكم (النفق مرتفع الزمن ومتذبذب؛ فقدان نبضة لا يعني انقطاعاً)
    [ -z "$_tl" ] && _tl=$(ping_ms "$TUN_PEER")
    [ -n "$_tl" ] && _tunup=true
  fi
  _gtrun=false; pgrep -f glorytun-udp >/dev/null 2>&1 && _gtrun=true
  # تسامح ضد الإنذارات الكاذبة: إذا كانت خدمة النفق شغّالة وله IP، اعتبره متصلاً
  # حتى لو فُقد نبض الفحص (التصفح لا ينقطع فعلاً لأنه يمر عبر البروكسي/الدمج)
  if [ "$_tunup" != "true" ] && [ "$_gtrun" = "true" ] && [ -n "$_tunip" ]; then
    _tunup=true
    [ -z "$_tl" ] && _tl="service"
  fi

  _vl=$(ping_ms "$VPS_HOST"); _vok=false; [ -n "$_vl" ] && _vok=true
  if [ "$_vok" = "false" ] && [ -n "$VPS_HOST" ]; then
    if curl -4 -sk -m 3 -o /dev/null "https://$VPS_HOST:65500/" 2>/dev/null; then
      _vok=true; _vl="tcp"
    fi
  fi
  _prun=false; pgrep -f sslocal >/dev/null 2>&1 && _prun=true
  _pen=false; /etc/init.d/shadowsocks-rust enabled 2>/dev/null && _pen=true
  _host=$(uci -q get system.@system[0].hostname); [ -z "$_host" ] && _host=OpenMPTCProuter
  _master=$(uci -q get openmptcprouter.settings.master); [ -z "$_master" ] && _master=balancing
  _sched=$(sysctl -n net.mptcp.scheduler 2>/dev/null)

  _bond_state="off"
  _bond_msg="الدمج غير شغال"
  _sched_is_red=0
  case "$_sched" in bpf_red|redundant) _sched_is_red=1 ;; esac
  if [ "$_tunup" = "true" ] && [ "$_prun" = "true" ] && [ "$_mp_online" -ge 1 ]; then
    _bond_state="active"
    if [ "$_mp_online" -ge 2 ]; then
      if [ "$_sched_is_red" = "1" ]; then
        _bond_msg="الدمج شغال — نسخ الحماية على $_mp_online خطوط (فصل خط لا يقطع العميل)"
      else
        _bond_msg="الدمج شغال — $_mp_online خطوط تشارك في التجميع"
      fi
    else
      _standby=$((_mp_ready - _mp_online))
      [ "$_standby" -lt 0 ] && _standby=0
      if [ "$_standby" -gt 0 ]; then
        _bond_msg="شغال بخط واحد — $_standby خط واقف سيشارك تلقائياً عند عودته (بدون قطع)"
      else
        _bond_msg="شغال بخط واحد — وصّل خطاً إضافياً لتفعيل النسخ على مسارين"
      fi
    fi
  elif [ "$_tunup" != "true" ]; then
    _bond_state="off"
    _bond_msg="الدمج متوقف — النفق غير متصل"
  elif [ "$_prun" != "true" ]; then
    _bond_state="off"
    _bond_msg="الدمج متوقف — البروكسي غير شغال"
  else
    _bond_state="off"
    _bond_msg="الدمج متوقف — لا توجد وصلات إنترنت جاهزة"
  fi

  _lanip=$(uci -q get network.lan.ipaddr)
  _clash=false
  _lan_pfx=$(printf '%s' "$_lanip" | awk -F. '{print $1"."$2"."$3}')
  for w in $WANS; do
    _wip=$(ubus call network.interface."$w" status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
    _wpfx=$(printf '%s' "$_wip" | awk -F. '{print $1"."$2"."$3}')
    [ -n "$_lan_pfx" ] && [ -n "$_wpfx" ] && [ "$_lan_pfx" = "$_wpfx" ] && _clash=true
  done

  printf '{'
  printf '"time":%s,' "$(date +%s)"
  printf '"host":"%s",' "$_host"
  printf '"version":"%s",' "$LOCAL_VER"
  printf '"vps":{"host":"%s","reachable":%s,"lat":"%s"},' "$VPS_HOST" "$_vok" "$_vl"
  printf '"tunnel":{"dev":"%s","peer":"%s","up":%s,"lat":"%s","service":%s,"ip":"%s"},' \
    "$TUN_DEV" "$TUN_PEER" "$_tunup" "${_tl:-}" "$_gtrun" "$_tunip"
  printf '"proxy":{"name":"shadowsocks-rust","running":%s,"enabled":%s},' "$_prun" "$_pen"
  printf '"bonding":{"state":"%s","message":"%s","master":"%s","scheduler":"%s","paths_online":%s,"paths_ready":%s,"wans_online":%s,"redundant":%s},' \
    "$_bond_state" "$_bond_msg" "$_master" "$_sched" "$_mp_online" "$_mp_ready" "$_net_ready" \
    "$([ "$_sched_is_red" = "1" ] && echo true || echo false)"
  printf '"warnings":{"lan_wan_clash":%s},' "$_clash"

  # Exit IP + latency after bonding (cached ~40s). IP via SS socks; ping = tunnel peer (path after merge).
  _exit_ip=""; _exit_lat=""; _exit_ok=false
  _ef=/tmp/omr-exit-cache
  _now=$(date +%s)
  if [ -f "$_ef" ]; then
    IFS='|' read -r _exit_ip _exit_lat _et < "$_ef"
    [ -n "$_et" ] && [ $((_now - _et)) -le 40 ] 2>/dev/null || { _exit_ip=""; _exit_lat=""; }
  fi
  if { [ -z "$_exit_ip" ] || [ -z "$_exit_lat" ]; } && { [ "$_tunup" = "true" ] || [ "$_prun" = "true" ]; }; then
    if [ -z "$_exit_ip" ] && command -v curl >/dev/null 2>&1; then
      for _eu in "https://api.ipify.org" "http://checkip.amazonaws.com" "http://ifconfig.me/ip"; do
        _exit_ip=$(curl -4 -fsS -m 6 --socks5-hostname 127.0.0.1:1111 "$_eu" 2>/dev/null | tr -d ' \r\n\t')
        case "$_exit_ip" in *.*.*.*) break ;; *) _exit_ip="" ;; esac
      done
      if [ -z "$_exit_ip" ]; then
        for _eu in "http://ip.openmptcprouter.com" "https://api.ipify.org"; do
          _exit_ip=$(curl -4 -fsS -m 4 "$_eu" 2>/dev/null | tr -d ' \r\n\t')
          case "$_exit_ip" in *.*.*.*) break ;; *) _exit_ip="" ;; esac
        done
      fi
    fi
    if [ -z "$_exit_lat" ]; then
      if [ "$_tunup" = "true" ]; then
        _exit_lat=$(ping_ms "$TUN_PEER")
      fi
      [ -z "$_exit_lat" ] && _exit_lat=$(ping_ms 1.1.1.1)
    fi
    printf '%s|%s|%s\n' "${_exit_ip:-}" "${_exit_lat:-}" "$_now" > "$_ef"
  fi
  [ -n "$_exit_ip" ] && _exit_ok=true

  printf '"exit":{"ip":"%s","lat":"%s","ok":%s},' "$_exit_ip" "$_exit_lat" "$_exit_ok"
  printf '"wans":[%s]' "$_wj"
  printf '}'
}

