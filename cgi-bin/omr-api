  _ss_key_set=false; [ -n "$_ss_pass" ] && _ss_key_set=true
  _ss_rules_dis=$(uci -q get shadowsocks-rust.ss_rules.disabled); [ -z "$_ss_rules_dis" ] && _ss_rules_dis=0
  _ss_redir=$(uci -q get shadowsocks-rust.ss_rules.redir_tcp); [ -z "$_ss_redir" ] && _ss_redir=all

  _lan_ip=$(uci -q get network.lan.ipaddr)
  _lan_mask=$(uci -q get network.lan.netmask); [ -z "$_lan_mask" ] && _lan_mask=255.255.255.0
  _lan_proto=$(uci -q get network.lan.proto); [ -z "$_lan_proto" ] && _lan_proto=static
  _lan_gw=$(uci -q get network.lan.gateway)
  _lan_dev=$(uci -q get network.lan.device); [ -z "$_lan_dev" ] && _lan_dev=br-lan
  _dhcp_ignore=$(uci -q get dhcp.lan.ignore); [ -z "$_dhcp_ignore" ] && _dhcp_ignore=0
  _dhcp_start=$(uci -q get dhcp.lan.start); [ -z "$_dhcp_start" ] && _dhcp_start=100
  _dhcp_limit=$(uci -q get dhcp.lan.limit); [ -z "$_dhcp_limit" ] && _dhcp_limit=150
