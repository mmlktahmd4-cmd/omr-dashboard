#!/bin/sh
# OMR Connect API — status + real setup actions (LAN only)
printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-cache, no-store\r\n'
printf 'Access-Control-Allow-Origin: *\r\n'
printf '\r\n'

qget() {
  printf '%s' "$QUERY_STRING" | sed -n "s/.*\(^\|&\)$1=\([^&]*\).*/\2/p" | head -1 | sed 's/+/ /g' | sed 's/%3A/:/gi;s/%2F/\//gi;s/%40/@/gi;s/%3D/=/gi;s/%2B/+/gi;s/%20/ /g'
}

A=$(qget a); [ -z "$A" ] && A=status
# merge POST body into query for forms
if [ "$REQUEST_METHOD" = "POST" ]; then
  _cl=${CONTENT_LENGTH:-0}
  if [ "$_cl" -gt 0 ] 2>/dev/null; then
    _post=$(dd bs=1 count="$_cl" 2>/dev/null)
    QUERY_STRING="${QUERY_STRING}&${_post}"
    A=$(qget a); [ -z "$A" ] && A=status
  fi
fi
I=$(qget i)
case "$I" in wan[0-9]|wan[0-9][0-9]) : ;; *) I="" ;; esac

WANS=$(ubus list 2>/dev/null | sed -n 's#^network\.interface\.\(wan[0-9]*\)$#\1#p')
VPS_HOST=$(uci -q get glorytun-udp.vpn.host)
[ -z "$VPS_HOST" ] && VPS_HOST=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
TUN_DEV=$(uci -q get glorytun-udp.vpn.dev); [ -z "$TUN_DEV" ] && TUN_DEV=tun0
TUN_PEER=$(uci -q get glorytun-udp.vpn.remoteip); [ -z "$TUN_PEER" ] && TUN_PEER=10.255.254.1

OTA_RAW="https://raw.githubusercontent.com/mmlktahmd4-cmd/omr-dashboard/main"
VER_FILE="/www/omr-dash/VERSION"
LOCAL_VER=$(cat "$VER_FILE" 2>/dev/null | tr -d ' \r\n'); [ -z "$LOCAL_VER" ] && LOCAL_VER="0"

fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL -m 45 "$1"
  else uclient-fetch -q -T 45 -O - "$1"; fi
}
fetch_insecure() {
  # HTTPS with self-signed VPS admin cert
  if command -v curl >/dev/null 2>&1; then curl -fskL -m 20 "$@"
  elif command -v wget >/dev/null 2>&1; then wget -qO- --no-check-certificate -T 20 "$@"
  else return 1; fi
}
json_str() {
  printf '"'
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' '\001' | sed 's/\001/\\n/g'
  printf '"'
}
ping_ms() {
  _o=$(ping -c1 -W2 ${2:+-I "$2"} "$1" 2>/dev/null)
  printf '%s' "$_o" | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1
}
ok_json() { printf '{"ok":true,"a":"%s"%s}' "$1" "${2:-}"; }
err_json() { printf '{"ok":false,"error":%s%s}' "$(json_str "$1")" "${2:-}"; }

# ---------- status ----------
status_json() {
  _wj=""
  for w in $WANS; do
    _st=$(ubus call network.interface."$w" status 2>/dev/null)
    _up=$(printf '%s' "$_st" | jsonfilter -e '@.up' 2>/dev/null)
    _dev=$(printf '%s' "$_st" | jsonfilter -e '@.l3_device' 2>/dev/null)
    [ -z "$_dev" ] && _dev=$(printf '%s' "$_st" | jsonfilter -e '@.device' 2>/dev/null)
    [ -z "$_dev" ] && _dev=$(uci -q get network."$w".device)
    _ip=$(printf '%s' "$_st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
    _proto=$(printf '%s' "$_st" | jsonfilter -e '@.proto' 2>/dev/null)
    _gw=$(printf '%s' "$_st" | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
    [ -z "$_gw" ] && _gw=$(printf '%s' "$_st" | jsonfilter -e '@.inactive.route[0].nexthop' 2>/dev/null)
    [ -z "$_gw" ] && _gw=$(uci -q get network."$w".gateway)
    _mp=$(uci -q get network."$w".multipath)
    _link=false; _speed=""
    if [ -n "$_dev" ]; then
      _et=$(ethtool "$_dev" 2>/dev/null)
      printf '%s' "$_et" | grep -q "Link detected: yes" && _link=true
      _speed=$(printf '%s' "$_et" | sed -n 's/.*Speed: \([0-9]*\)Mb\/s/\1/p' | head -1)
    fi

    # bandwidth: compare with previous sample
    _rxr=0; _txr=0; _rxb=0; _txb=0
    if [ -n "$_dev" ] && [ -f "/sys/class/net/$_dev/statistics/rx_bytes" ]; then
      _rxb=$(cat /sys/class/net/"$_dev"/statistics/rx_bytes 2>/dev/null)
      _txb=$(cat /sys/class/net/"$_dev"/statistics/tx_bytes 2>/dev/null)
      _now=$(date +%s)
      _f="/tmp/omr-bw-$_dev"
      if [ -f "$_f" ]; then
        read _prx _ptx _pt < "$_f"
        _dt=$((_now - _pt))
        if [ "$_dt" -gt 0 ] 2>/dev/null; then
          _rxr=$(( (_rxb - _prx) * 8 / _dt ))
          _txr=$(( (_txb - _ptx) * 8 / _dt ))
          [ "$_rxr" -lt 0 ] && _rxr=0
          [ "$_txr" -lt 0 ] && _txr=0
        fi
      fi
      echo "$_rxb $_txb $_now" > "$_f"
    fi

    _net=false; _lat=""; _gwlat=""
    if [ "$_up" = "true" ] && [ -n "$_dev" ] && [ "$_link" = "true" ]; then
      _lat=$(ping_ms 1.1.1.1 "$_dev")
      [ -n "$_lat" ] && _net=true
      [ -n "$_gw" ] && _gwlat=$(ping_ms "$_gw" "$_dev")
    fi
    [ -z "$_up" ] && _up=false
    [ -n "$_wj" ] && _wj="$_wj,"
    _wj="$_wj{\"name\":\"$w\",\"up\":$_up,\"dev\":\"$_dev\",\"ip\":\"$_ip\",\"proto\":\"$_proto\",\"gateway\":\"$_gw\",\"multipath\":\"$_mp\",\"link\":$_link,\"speed\":\"$_speed\",\"net\":$_net,\"lat\":\"$_lat\",\"gw_lat\":\"$_gwlat\",\"rx_bps\":$_rxr,\"tx_bps\":$_txr,\"rx_bytes\":$_rxb,\"tx_bytes\":$_txb}"
  done

  _tunup=false
  if ip link show "$TUN_DEV" >/dev/null 2>&1; then
    _tl=$(ping_ms "$TUN_PEER")
    [ -n "$_tl" ] && _tunup=true
  fi
  _vl=$(ping_ms "$VPS_HOST"); _vok=false; [ -n "$_vl" ] && _vok=true
  _prun=false; pgrep -f sslocal >/dev/null 2>&1 && _prun=true
  _pen=false; /etc/init.d/shadowsocks-rust enabled 2>/dev/null && _pen=true
  _gtrun=false; pgrep -f glorytun-udp >/dev/null 2>&1 && _gtrun=true
  _host=$(uci -q get system.@system[0].hostname); [ -z "$_host" ] && _host=OpenMPTCProuter

  # total throughput across up WANs
  _trx=0; _ttx=0
  # parsed later in UI from wans sum

  printf '{'
  printf '"time":%s,' "$(date +%s)"
  printf '"host":"%s",' "$_host"
  printf '"version":"%s",' "$LOCAL_VER"
  printf '"vps":{"host":"%s","reachable":%s,"lat":"%s"},' "$VPS_HOST" "$_vok" "$_vl"
  printf '"tunnel":{"dev":"%s","peer":"%s","up":%s,"lat":"%s","service":%s},' "$TUN_DEV" "$TUN_PEER" "$_tunup" "${_tl:-}" "$_gtrun"
  printf '"proxy":{"name":"shadowsocks-rust","running":%s,"enabled":%s},' "$_prun" "$_pen"
  printf '"wans":[%s]' "$_wj"
  printf '}'
}

# ---------- config read ----------
config_json() {
  _vip=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
  [ -z "$_vip" ] && _vip=$(uci -q get glorytun-udp.vpn.host)
  _vuser=$(uci -q get openmptcprouter.vps.username)
  _vport=$(uci -q get openmptcprouter.vps.port); [ -z "$_vport" ] && _vport=65500
  _vtok=$(uci -q get openmptcprouter.vps.password)
  _vpn=$(uci -q get openmptcprouter.settings.vpn)
  _proxy=$(uci -q get openmptcprouter.settings.proxy)
  _master=$(uci -q get openmptcprouter.settings.master)
  _profile=$(uci -q get openmptcprouter.settings.bond_profile); [ -z "$_profile" ] && _profile=custom
  _sched=$(uci -q get network.globals.mptcp_scheduler)
  _sched_live=$(sysctl -n net.mptcp.scheduler 2>/dev/null)
  _avail=$(sysctl -n net.mptcp.available_schedulers 2>/dev/null | tr ' ' ',')
  _ka=$(uci -q get glorytun-udp.vpn.keepalive)
  _ft=$(uci -q get omr-tracker.defaults.failure_interval)
  _lan_ip=$(uci -q get network.lan.ipaddr)
  _lan_mask=$(uci -q get network.lan.netmask); [ -z "$_lan_mask" ] && _lan_mask=255.255.255.0
  _lan_proto=$(uci -q get network.lan.proto); [ -z "$_lan_proto" ] && _lan_proto=static
  _lan_gw=$(uci -q get network.lan.gateway)
  _lan_dev=$(uci -q get network.lan.device); [ -z "$_lan_dev" ] && _lan_dev=br-lan
  _dhcp_ignore=$(uci -q get dhcp.lan.ignore); [ -z "$_dhcp_ignore" ] && _dhcp_ignore=0
  _dhcp_start=$(uci -q get dhcp.lan.start); [ -z "$_dhcp_start" ] && _dhcp_start=100
  _dhcp_limit=$(uci -q get dhcp.lan.limit); [ -z "$_dhcp_limit" ] && _dhcp_limit=150
  _dhcp_leasetime=$(uci -q get dhcp.lan.leasetime); [ -z "$_dhcp_leasetime" ] && _dhcp_leasetime=12h
  _lan_dhcp_server=true; [ "$_dhcp_ignore" = "1" ] && _lan_dhcp_server=false

  _devs=""
  for d in $(ls /sys/class/net 2>/dev/null); do
    case "$d" in lo|tun*|wg*|ifb*|sit*|gre*|teql*|ip6*|erspan*|br-*|wlan*|docker*|veth*) continue ;; esac
    _mac=$(cat /sys/class/net/"$d"/address 2>/dev/null)
    _carr=0; [ -f /sys/class/net/"$d"/carrier ] && _carr=$(cat /sys/class/net/"$d"/carrier 2>/dev/null)
    [ -n "$_devs" ] && _devs="$_devs,"
    _devs="$_devs{\"name\":\"$d\",\"mac\":\"$_mac\",\"carrier\":$_carr}"
  done

  _wj=""
  for w in $WANS; do
    _dev=$(uci -q get network."$w".device)
    _proto=$(uci -q get network."$w".proto)
    _mp=$(uci -q get network."$w".multipath)
    _auto=$(uci -q get network."$w".auto); [ -z "$_auto" ] && _auto=1
    _ip=$(uci -q get network."$w".ipaddr)
    _wmask=$(uci -q get network."$w".netmask)
    _gw=$(uci -q get network."$w".gateway)
    _dns=$(uci -q get network."$w".dns | tr '\n' ' ')
    _user=$(uci -q get network."$w".username)
    [ -n "$_wj" ] && _wj="$_wj,"
    _wj="$_wj{\"name\":\"$w\",\"dev\":\"$_dev\",\"proto\":\"$_proto\",\"multipath\":\"$_mp\",\"auto\":\"$_auto\",\"ip\":\"$_ip\",\"netmask\":\"$_wmask\",\"gateway\":\"$_gw\",\"dns\":\"$_dns\",\"username\":\"$_user\"}"
  done

  printf '{'
  printf '"ok":true,'
  printf '"server":{"ip":"%s","username":"%s","port":"%s","token_set":%s},' \
    "$_vip" "$_vuser" "$_vport" "$([ -n "$_vtok" ] && echo true || echo false)"
  printf '"settings":{"vpn":"%s","proxy":"%s","master":"%s","lan_ip":"%s","lan_mask":"%s","bond_profile":"%s","mptcp_scheduler":"%s","mptcp_live":"%s","mptcp_available":"%s","keepalive":"%s","tracker_fail_interval":"%s"},' \
    "$_vpn" "$_proxy" "$_master" "$_lan_ip" "$_lan_mask" "$_profile" "$_sched" "$_sched_live" "$_avail" "$_ka" "$_ft"
  printf '"lan":{"proto":"%s","ip":"%s","netmask":"%s","gateway":"%s","device":"%s","dhcp_server":%s,"dhcp_start":"%s","dhcp_limit":"%s","dhcp_leasetime":"%s"},' \
    "$_lan_proto" "$_lan_ip" "$_lan_mask" "$_lan_gw" "$_lan_dev" "$_lan_dhcp_server" "$_dhcp_start" "$_dhcp_limit" "$_dhcp_leasetime"
  printf '"devices":[%s],' "$_devs"
  printf '"wans":[%s]' "$_wj"
  printf '}'
}

# ---------- bonding profiles ----------
set_bond() {
  PROF=$(qget profile); [ -z "$PROF" ] && PROF=smooth
  SCHED=$(qget scheduler)
  MASTER=$(qget master)
  KA=$(qget keepalive)
  FAILI=$(qget fail_interval)

  # apply profile defaults first, then honor explicit UI overrides
  case "$PROF" in
    smooth)
      MASTER=balancing; SCHED=bpf_red; KA=5s; FAILI=2
      uci set network.wan1.multipath='on'
      uci set network.wan2.multipath='on'
      uci set network.wan2.auto='1'
      uci -q delete network.wan2.disabled || true
      uci set openmptcprouter.wan1.multipath='on'
      uci set openmptcprouter.wan2.multipath='on'
      ;;
    speed)
      MASTER=balancing; SCHED=bpf_rr; KA=10s; FAILI=3
      uci set network.wan1.multipath='on'
      uci set network.wan2.multipath='on'
      uci set network.wan2.auto='1'
      uci -q delete network.wan2.disabled || true
      uci set openmptcprouter.wan1.multipath='on'
      uci set openmptcprouter.wan2.multipath='on'
      ;;
    failover)
      MASTER=failover; SCHED=bpf_bkup; KA=5s; FAILI=2
      uci set network.wan1.multipath='master'
      uci set network.wan2.multipath='backup'
      uci set network.wan2.auto='1'
      uci set openmptcprouter.wan1.multipath='master'
      uci set openmptcprouter.wan2.multipath='backup'
      ;;
    custom)
      [ -z "$SCHED" ] && SCHED=$(uci -q get network.globals.mptcp_scheduler)
      [ -z "$MASTER" ] && MASTER=$(uci -q get openmptcprouter.settings.master)
      [ -z "$KA" ] && KA=$(uci -q get glorytun-udp.vpn.keepalive)
      [ -z "$FAILI" ] && FAILI=$(uci -q get omr-tracker.defaults.failure_interval)
      ;;
    *) err_json "unknown profile"; return ;;
  esac

  # UI overrides (editable fields)
  _os=$(qget scheduler); [ -n "$_os" ] && SCHED="$_os"
  _om=$(qget master); [ -n "$_om" ] && MASTER="$_om"
  _ok=$(qget keepalive); [ -n "$_ok" ] && KA="$_ok"
  _of=$(qget fail_interval); [ -n "$_of" ] && FAILI="$_of"
  [ -z "$SCHED" ] && SCHED=default
  [ -z "$MASTER" ] && MASTER=balancing
  [ -z "$KA" ] && KA=5s
  [ -z "$FAILI" ] && FAILI=2

  # validate scheduler against kernel (fallback without wiping override intent)
  _ok=0
  _avail=$(sysctl -n net.mptcp.available_schedulers 2>/dev/null)
  for s in $_avail; do
    [ "$s" = "$SCHED" ] && _ok=1
  done
  if [ "$_ok" = "0" ]; then
    case "$SCHED" in
      bpf_red|redundant) for s in $_avail; do case "$s" in bpf_red|redundant) SCHED=$s; _ok=1; break ;; esac; done ;;
      bpf_rr|roundrobin) for s in $_avail; do case "$s" in bpf_rr|roundrobin) SCHED=$s; _ok=1; break ;; esac; done ;;
      bpf_bkup|backup) for s in $_avail; do case "$s" in bpf_bkup|backup) SCHED=$s; _ok=1; break ;; esac; done ;;
    esac
  fi
  [ "$_ok" = "0" ] && SCHED=$(printf '%s' "$_avail" | awk '{print $1}')
  [ -z "$SCHED" ] && SCHED=default

  uci set openmptcprouter.settings.bond_profile="$PROF"
  uci set openmptcprouter.settings.master="$MASTER"
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set network.globals.mptcp_scheduler="$SCHED"
  uci set network.globals.mptcp_path_manager='fullmesh'
  uci set network.globals.mptcp_force_multipath='1'
  uci set glorytun-udp.vpn.keepalive="$KA"
  uci set omr-tracker.defaults.failure_interval="$FAILI"
  uci set omr-tracker.defaults.timeout='1'
  uci set omr-tracker.defaults.interval='1'
  uci set omr-tracker.defaults.tries='2'
  uci set network.wan1.peerdns='1'
  uci set network.wan2.peerdns='1'

  sysctl -w net.mptcp.scheduler="$SCHED" >/dev/null 2>&1 || true
  sysctl -w net.mptcp.stale_loss_cnt=2 >/dev/null 2>&1 || true
  CONF=/etc/sysctl.d/zzz_openmptcprouter.conf
  if [ -f "$CONF" ]; then
    grep -q '^net.mptcp.scheduler' "$CONF" \
      && sed -i "s/^net.mptcp.scheduler.*/net.mptcp.scheduler=$SCHED/" "$CONF" \
      || echo "net.mptcp.scheduler=$SCHED" >> "$CONF"
  fi

  uci commit openmptcprouter
  uci commit network
  uci commit glorytun-udp
  uci commit omr-tracker 2>/dev/null || uci commit
  /etc/init.d/omr-tracker restart >/dev/null 2>&1 || true
  /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true

  ok_json setbond ",\"profile\":\"$PROF\",\"scheduler\":\"$SCHED\",\"master\":\"$MASTER\",\"keepalive\":\"$KA\",\"fail_interval\":\"$FAILI\""
}

# ---------- set server + auto-fetch keys ----------
set_server() {
  HOST=$(qget host)
  TOKEN=$(qget token)
  PORT=$(qget port); [ -z "$PORT" ] && PORT=65500
  USER=$(qget user); [ -z "$USER" ] && USER=openmptcprouter
  if [ -z "$HOST" ]; then err_json "host required"; return; fi
  if [ -z "$TOKEN" ]; then TOKEN=$(uci -q get openmptcprouter.vps.password); fi
  if [ -z "$TOKEN" ]; then err_json "server key required"; return; fi

  uci -q delete openmptcprouter.vps.ip || true
  uci add_list openmptcprouter.vps.ip="$HOST"
  uci set openmptcprouter.vps.username="$USER"
  uci set openmptcprouter.vps.password="$TOKEN"
  uci set openmptcprouter.vps.port="$PORT"
  uci set openmptcprouter.vps.get_config='1'
  uci set openmptcprouter.vps.set_firewall='1'
  uci set openmptcprouter.vps.master='1'
  uci set openmptcprouter.vps.current='1'

  uci set openmptcprouter.settings.vpn='glorytun_udp'
  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set openmptcprouter.settings.disableserverping='0'

  uci set glorytun-udp.vpn.enable='1'
  uci set glorytun-udp.vpn.host="$HOST"
  uci set glorytun-udp.vpn.port='65001'
  uci set glorytun-udp.vpn.dev='tun0'

  uci set shadowsocks-rust.sss0.server="$HOST"
  uci -q set shadowsocks-rust.sss0.disabled='0'

  # --- pull token + config from VPS admin API (HTTPS then HTTP) ---
  KEYS_OK=0
  GT_OK=0
  SS_OK=0
  MSG=""
  CFG=/tmp/omr-vps-cfg.json
  TOKFILE=/tmp/omr-vps-tok.json
  rm -f "$CFG" "$TOKFILE"
  for SCHEME in https http; do
    BASE="$SCHEME://$HOST:$PORT"
    if command -v curl >/dev/null 2>&1; then
      curl -sk -m 20 -X POST "$BASE/token" \
        -d "username=$USER&password=$TOKEN" > "$TOKFILE" 2>/dev/null || true
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$TOKFILE" --no-check-certificate -T 20 \
        --post-data="username=$USER&password=$TOKEN" "$BASE/token" 2>/dev/null || true
    fi
    ACCESS=$(sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TOKFILE" 2>/dev/null | head -1)
    [ -z "$ACCESS" ] && continue
    if command -v curl >/dev/null 2>&1; then
      curl -sk -m 25 -H "Authorization: Bearer $ACCESS" "$BASE/config" > "$CFG" 2>/dev/null || true
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$CFG" --no-check-certificate -T 25 \
        --header="Authorization: Bearer $ACCESS" "$BASE/config" 2>/dev/null || true
    fi
    [ -s "$CFG" ] && grep -q '"glorytun"' "$CFG" 2>/dev/null && break
  done

  if [ -s "$CFG" ] && grep -q '"glorytun"' "$CFG" 2>/dev/null; then
    KEYS_OK=1
    GTKEY=$(jsonfilter -i "$CFG" -e '@.glorytun.key' 2>/dev/null)
    GTPORT=$(jsonfilter -i "$CFG" -e '@.glorytun.port' 2>/dev/null)
    GTPEER=$(jsonfilter -i "$CFG" -e '@.glorytun.udp.host_ip' 2>/dev/null)
    GTCHA=$(jsonfilter -i "$CFG" -e '@.glorytun.chacha' 2>/dev/null)
    if [ -n "$GTKEY" ]; then
      uci set glorytun-udp.vpn.key="$GTKEY"
      [ -n "$GTPORT" ] && uci set glorytun-udp.vpn.port="$GTPORT"
      [ -n "$GTPEER" ] && uci set glorytun-udp.vpn.remoteip="$GTPEER"
      if [ "$GTCHA" = "true" ] || [ "$GTCHA" = "1" ]; then
        uci set glorytun-udp.vpn.chacha20='1'
      fi
      GT_OK=1
    fi

    # prefer shadowsocks-rust (2022) from xray.config, else classic shadowsocks
    SSRKEY=$(jsonfilter -i "$CFG" -e '@.xray.config.sskey' 2>/dev/null)
    SSRMETHOD=$(jsonfilter -i "$CFG" -e '@.xray.config.ss_method' 2>/dev/null)
    SSPORT=$(jsonfilter -i "$CFG" -e '@.shadowsocks.port' 2>/dev/null)
    SSKEY=$(jsonfilter -i "$CFG" -e '@.shadowsocks.key' 2>/dev/null)
    SSMETHOD=$(jsonfilter -i "$CFG" -e '@.shadowsocks.method' 2>/dev/null)
    if [ -n "$SSRKEY" ]; then
      uci set shadowsocks-rust.sss0.password="$SSRKEY"
      [ -n "$SSRMETHOD" ] && uci set shadowsocks-rust.sss0.method="$SSRMETHOD"
      uci set shadowsocks-rust.sss0.server_port='65280'
      SS_OK=1
    elif [ -n "$SSKEY" ]; then
      uci set shadowsocks-rust.sss0.password="$SSKEY"
      [ -n "$SSMETHOD" ] && uci set shadowsocks-rust.sss0.method="$SSMETHOD"
      [ -n "$SSPORT" ] && uci set shadowsocks-rust.sss0.server_port="$SSPORT"
      SS_OK=1
    fi
    MSG="keys fetched from API"
  else
    MSG="API unreachable — saved login; openmptcprouter-vps will retry get_config"
  fi

  uci commit openmptcprouter
  uci commit glorytun-udp
  uci commit shadowsocks-rust

  /etc/init.d/openmptcprouter-vps restart >/dev/null 2>&1 || true
  /etc/init.d/openmptcprouter restart >/dev/null 2>&1 || true
  sleep 2
  /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
  ifup omrvpn >/dev/null 2>&1 || true
  /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1 || true

  ok_json setserver ",\"host\":\"$HOST\",\"port\":\"$PORT\",\"keys_ok\":$KEYS_OK,\"glorytun\":$GT_OK,\"shadowsocks\":$SS_OK,\"msg\":$(json_str "$MSG")"
}

# ---------- OTA update ----------
do_update() {
  CB=$(date +%s)
  SCRIPT=/tmp/omr-ota-install.sh
  LOGF=/tmp/omr-ota.log
  rm -f "$SCRIPT" "$LOGF"
  OLD="$LOCAL_VER"
  if ! fetch "$OTA_RAW/install.sh?t=$CB" > "$SCRIPT" 2>"$LOGF"; then
    # fallback without query string (some fetchers dislike ?)
    if ! fetch "$OTA_RAW/install.sh" > "$SCRIPT" 2>>"$LOGF"; then
      err_json "download failed" ",\"log\":$(json_str "$(cat "$LOGF" 2>/dev/null)")"
      return
    fi
  fi
  if [ ! -s "$SCRIPT" ]; then
    err_json "empty install script"; return
  fi
  sed -i 's/\r$//' "$SCRIPT" 2>/dev/null || true
  chmod +x "$SCRIPT"
  sh "$SCRIPT" >"$LOGF" 2>&1
  RC=$?
  NEW=$(cat "$VER_FILE" 2>/dev/null | tr -d ' \r\n')
  [ -z "$NEW" ] && NEW="$OLD"
  if [ "$RC" -ne 0 ] && [ "$NEW" = "$OLD" ]; then
    err_json "update failed" ",\"version\":\"$NEW\",\"log\":$(json_str "$(tail -c 1500 "$LOGF" 2>/dev/null)")"
    return
  fi
  # bust LuCI caches again
  rm -rf /tmp/luci-* /tmp/luci-indexcache* 2>/dev/null || true
  /etc/init.d/uhttpd reload >/dev/null 2>&1 || true
  printf '{"ok":true,"a":"update","version":"%s","old":"%s","log":%s}' "$NEW" "$OLD" "$(json_str "$(tail -c 1200 "$LOGF" 2>/dev/null)")"
}

# ---------- set WAN / broadband ----------
set_wan() {
  DEV=$(qget dev)
  PROTO=$(qget proto)
  MP=$(qget multipath); [ -z "$MP" ] && MP=on
  EN=$(qget enable); [ -z "$EN" ] && EN=1
  IP=$(qget ip); MASK=$(qget netmask); GW=$(qget gateway); DNS=$(qget dns)
  PPUSER=$(qget username); PPPASS=$(qget password)
  if [ -z "$I" ]; then err_json "interface required (wan1/wan2)"; return; fi
  [ -z "$DEV" ] && DEV=$(uci -q get network."$I".device)
  if [ -z "$DEV" ]; then err_json "device required"; return; fi
  [ -z "$PROTO" ] && PROTO=$(uci -q get network."$I".proto)
  [ -z "$PROTO" ] && PROTO=dhcp

  N=$(printf '%s' "$I" | sed 's/wan//')
  MET=$((4 + N))

  uci set network."$I"=interface
  uci set network."$I".device="$DEV"
  uci set network."$I".multipath="$MP"
  uci set network."$I".defaultroute='1'
  uci set network."$I".peerdns='1'
  uci set network."$I".ipv6='0'
  uci set network."$I".metric="$MET"
  uci set network."$I".ip4table="$MET"
  uci set network."$I".label="$I"

  # clear previous proto-specific options
  uci -q delete network."$I".ipaddr
  uci -q delete network."$I".netmask
  uci -q delete network."$I".gateway
  uci -q delete network."$I".dns
  uci -q delete network."$I".username
  uci -q delete network."$I".password

  case "$PROTO" in
    static)
      uci set network."$I".proto='static'
      [ -n "$IP" ] && uci set network."$I".ipaddr="$IP"
      [ -n "$MASK" ] && uci set network."$I".netmask="$MASK"
      [ -n "$GW" ] && uci set network."$I".gateway="$GW"
      if [ -n "$DNS" ]; then
        uci -q delete network."$I".dns
        for d in $DNS; do uci add_list network."$I".dns="$d"; done
        uci set network."$I".peerdns='0'
      fi
      ;;
    pppoe)
      uci set network."$I".proto='pppoe'
      uci set network."$I".username="$PPUSER"
      uci set network."$I".password="$PPPASS"
      ;;
    *)
      uci set network."$I".proto='dhcp'
      ;;
  esac

  if [ "$EN" = "0" ]; then uci set network."$I".auto='0'
  else uci set network."$I".auto='1'; uci -q delete network."$I".disabled || true
  fi

  uci set openmptcprouter."$I"=interface
  uci set openmptcprouter."$I".multipath="$MP"
  echo "$(uci -q get firewall.zone_wan.network)" | grep -qw "$I" || uci add_list firewall.zone_wan.network="$I"

  uci commit network
  uci commit openmptcprouter
  uci commit firewall
  /etc/init.d/firewall reload >/dev/null 2>&1 || true
  if [ "$EN" = "0" ]; then ifdown "$I" >/dev/null 2>&1 || true
  else ifdown "$I" >/dev/null 2>&1 || true; sleep 1; ifup "$I" >/dev/null 2>&1 || true
  fi
  ok_json setwan ',"i":"'"$I"'","dev":"'"$DEV"'","proto":"'"$PROTO"'","multipath":"'"$MP"'"'
}

# ---------- LAN (exit / client side) ----------
set_lan() {
  PROTO=$(qget proto); [ -z "$PROTO" ] && PROTO=static
  IP=$(qget ip)
  MASK=$(qget netmask); [ -z "$MASK" ] && MASK=255.255.255.0
  GW=$(qget gateway)
  DHCP_SRV=$(qget dhcp_server)
  DHCP_START=$(qget dhcp_start)
  DHCP_LIMIT=$(qget dhcp_limit)
  DHCP_LEASE=$(qget dhcp_leasetime)

  case "$PROTO" in
    dhcp)
      uci set network.lan.proto='dhcp'
      uci -q delete network.lan.ipaddr || true
      uci -q delete network.lan.netmask || true
      uci -q delete network.lan.gateway || true
      ;;
    static|*)
      PROTO=static
      case "$IP" in
        *.*.*.*) : ;;
        *) printf '{"ok":false,"error":"invalid lan ip"}'; return ;;
      esac
      uci set network.lan.proto='static'
      uci set network.lan.ipaddr="$IP"
      uci set network.lan.netmask="$MASK"
      if [ -n "$GW" ]; then uci set network.lan.gateway="$GW"
      else uci -q delete network.lan.gateway || true; fi
      ;;
  esac

  # DHCP server for LAN clients (dnsmasq) — independent of lan.proto
  if [ "$DHCP_SRV" = "0" ] || [ "$DHCP_SRV" = "false" ] || [ "$DHCP_SRV" = "off" ]; then
    uci set dhcp.lan.ignore='1'
  else
    uci -q delete dhcp.lan.ignore || true
    [ -n "$DHCP_START" ] && uci set dhcp.lan.start="$DHCP_START"
    [ -n "$DHCP_LIMIT" ] && uci set dhcp.lan.limit="$DHCP_LIMIT"
    [ -n "$DHCP_LEASE" ] && uci set dhcp.lan.leasetime="$DHCP_LEASE"
  fi

  uci commit network
  uci commit dhcp
  (sleep 1; /etc/init.d/network restart; /etc/init.d/dnsmasq restart) >/dev/null 2>&1 &
  ok_json setlan ',"proto":"'"$PROTO"'","ip":"'"$IP"'","lan_changed":1'
}

# ---------- settings ----------
set_settings() {
  VPN=$(qget vpn)
  PROXY=$(qget proxy)
  MASTER=$(qget master)
  LANIP=$(qget lan_ip)
  [ -n "$VPN" ] && uci set openmptcprouter.settings.vpn="$VPN"
  [ -n "$PROXY" ] && uci set openmptcprouter.settings.proxy="$PROXY"
  [ -n "$MASTER" ] && uci set openmptcprouter.settings.master="$MASTER"
  LAN_CHANGED=0
  if [ -n "$LANIP" ]; then
    case "$LANIP" in
      *.*.*.*)
        uci set network.lan.proto='static'
        uci set network.lan.ipaddr="$LANIP"
        LAN_CHANGED=1
        ;;
    esac
  fi
  uci commit openmptcprouter
  uci commit network
  if [ "$VPN" = "glorytun_udp" ]; then
    uci set glorytun-udp.vpn.enable='1'; uci commit glorytun-udp
    /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
  fi
  if [ "$LAN_CHANGED" = "1" ]; then
    (sleep 1; /etc/init.d/network restart) >/dev/null 2>&1 &
  fi
  ok_json setsettings ',"lan_changed":'"$LAN_CHANGED"
}

case "$A" in
  wanup)      [ -n "$I" ] && ifup "$I" >/dev/null 2>&1;   ok_json wanup ',"i":"'"$I"'"' ;;
  wandown)    [ -n "$I" ] && ifdown "$I" >/dev/null 2>&1; ok_json wandown ',"i":"'"$I"'"' ;;
  wanrestart) [ -n "$I" ] && { ifdown "$I" >/dev/null 2>&1; sleep 1; ifup "$I" >/dev/null 2>&1; }
              ok_json wanrestart ',"i":"'"$I"'"' ;;
  vpn)        /etc/init.d/glorytun-udp restart >/dev/null 2>&1; ifup omrvpn >/dev/null 2>&1; ok_json vpn ;;
  proxy)      /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1; ok_json proxy ;;
  reconnect)  for w in $WANS; do ifup "$w" >/dev/null 2>&1; done
              /etc/init.d/glorytun-udp restart >/dev/null 2>&1; ifup omrvpn >/dev/null 2>&1
              /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1; ok_json reconnect ;;
  exitip)     _e=$(uclient-fetch -q -T 8 -O - http://ip.openmptcprouter.com 2>/dev/null)
              printf '{"ok":true,"exit_ip":"%s"}' "$_e" ;;
  version)    _r=$(fetch "$OTA_RAW/VERSION?t=$(date +%s)" 2>/dev/null | tr -d ' \r\n')
              [ -z "$_r" ] && _r=$(fetch "$OTA_RAW/VERSION" 2>/dev/null | tr -d ' \r\n')
              printf '{"ok":true,"local":"%s","remote":"%s","update_available":%s}' \
                "$LOCAL_VER" "$_r" "$([ -n "$_r" ] && [ "$_r" != "$LOCAL_VER" ] && echo true || echo false)" ;;
  update)     do_update ;;
  config)     config_json ;;
  setserver)  set_server ;;
  setwan)     set_wan ;;
  setsettings) set_settings ;;
  setlan)     set_lan ;;
  setbond)    set_bond ;;
  status|*)   status_json ;;
esac
