  ok_json setproxy ",\"enable\":\"$EN\",\"server\":\"$HOST\",\"port\":\"$PORT\",\"method\":\"$METHOD\""
}

# ---------- Max efficiency stack aligned with VPS ----------
optimize_stack() {
  MODE=$(qget mode); [ -z "$MODE" ] && MODE=smooth
  HOST=$(uci -q get openmptcprouter.vps.ip | awk '{print $1}')
  [ -z "$HOST" ] && HOST=$(uci -q get glorytun-udp.vpn.host)

  # جدولة النواة المدمجة (default) هي الوحيدة المستقرة على هذه النواة؛
  # جدولات bpf_* تُسبّب تحذيرات/تعليق في MPTCP وتقطيع الإنترنت
  case "$MODE" in
    speed) SCHED=default; KA=10s; FAILI=5; MASTER=balancing ;;
    failover) SCHED=default; KA=10s; FAILI=5; MASTER=failover ;;
    *) MODE=smooth; SCHED=default; KA=10s; FAILI=5; MASTER=balancing ;;
  esac

  # validate scheduler
  _avail=$(sysctl -n net.mptcp.available_schedulers 2>/dev/null)
  _ok=0
  for s in $_avail; do [ "$s" = "$SCHED" ] && _ok=1; done
  [ "$_ok" = "0" ] && SCHED=$(printf '%s' "$_avail" | awk '{print $1}')
  [ -z "$SCHED" ] && SCHED=default

  uci set openmptcprouter.settings.vpn='glorytun_udp'
  uci set openmptcprouter.settings.proxy='shadowsocks-rust'
  uci set openmptcprouter.settings.master="$MASTER"
  uci set openmptcprouter.settings.mptcpovervpn='none'
  uci set openmptcprouter.settings.bond_profile="$MODE"
  uci set openmptcprouter.settings.enable_nodelay='1'
  uci set openmptcprouter.settings.disable_ipv6='1'
  uci set openmptcprouter.settings.scaling_governor='performance'
  uci set openmptcprouter.settings.disableserverping='0'

  uci set network.globals.multipath='enable'
  uci set network.globals.mptcp_scheduler="$SCHED"
  uci set network.globals.mptcp_path_manager='fullmesh'
  uci set network.globals.mptcp_force_multipath='1'
  uci set network.globals.congestion='bbr'
  uci set network.globals.mptcp_checksum='0'
  uci set network.globals.mptcp_subflows='8'
  uci set network.globals.mptcp_add_addr_accepted='8'
  uci set network.globals.mptcp_syn_retries='4'

  # For smooth/redundant: ALL lines stay "on" so each carries a copy (no backup idle)
  _bi=0
  for _bw in $(list_wans); do
    _bi=$((_bi+1))
    if [ "$MODE" = "failover" ]; then
      if [ "$_bi" = "1" ]; then
        uci set network."$_bw".multipath='master'
        uci set openmptcprouter."$_bw".multipath='master'
      else
        uci set network."$_bw".multipath='backup'
        uci set openmptcprouter."$_bw".multipath='backup'
      fi
    else
      uci set network."$_bw".multipath='on'
      uci set openmptcprouter."$_bw".multipath='on'
    fi
    uci set network."$_bw".auto='1'
    uci set network."$_bw".defaultroute='0'
    uci set network."$_bw".peerdns='0'
    uci set network."$_bw".delegate='0'
    uci -q delete network."$_bw".disabled || true
  done

  if [ -n "$HOST" ]; then
    uci set glorytun-udp.vpn.enable='1'
    uci set glorytun-udp.vpn.host="$HOST"
    uci set glorytun-udp.vpn.port='65001'
    uci set glorytun-udp.vpn.dev='tun0'
    uci set glorytun-udp.vpn.keepalive="$KA"
    uci set glorytun-udp.vpn.chacha20='1'
    uci set glorytun-udp.vpn.localip='10.255.254.2'
    uci set glorytun-udp.vpn.remoteip='10.255.254.1'
    uci set network.omrvpn=interface
    uci set network.omrvpn.proto='static'
    uci set network.omrvpn.device='tun0'
    uci set network.omrvpn.ipaddr='10.255.254.2'
    uci set network.omrvpn.netmask='255.255.255.252'
    uci set network.omrvpn.gateway='10.255.254.1'
    uci set network.omrvpn.multipath='off'
    uci set network.omrvpn.metric='1500'
    uci set shadowsocks-rust.sss0.server="$HOST"
    uci set shadowsocks-rust.sss0.server_port='65280'
    uci set shadowsocks-rust.sss0.disabled='0'
    fix_ss_path "$HOST"
  fi

  uci set omr-tracker.defaults.enabled='1'
  uci set omr-tracker.defaults.failure_interval="$FAILI"
  uci set omr-tracker.defaults.timeout='3'
  uci set omr-tracker.defaults.interval='5'
  uci set omr-tracker.defaults.interval_tries='2'
  uci set omr-tracker.defaults.tries='3'
  uci set omr-tracker.defaults.tries_up='3'
  uci set omr-tracker.defaults.count='2'
  uci set omr-tracker.proxy.enabled='1'
  uci set omr-tracker.proxy.interval='10'
  uci set omr-tracker.proxy.timeout='5'
  uci set omr-tracker.server.enabled='1'
  uci set omr-tracker.server.interval='10'
  uci set omr-tracker.server.timeout='5'

  sysctl -w net.mptcp.scheduler="$SCHED" >/dev/null 2>&1 || true
  sysctl -w net.mptcp.enabled=1 >/dev/null 2>&1 || true
  case "$SCHED" in
    bpf_red|redundant)
      sysctl -w net.mptcp.stale_loss_cnt=1 >/dev/null 2>&1 || true
      sysctl -w net.mptcp.blackhole_timeout=0 >/dev/null 2>&1 || true
      ;;
  esac
  echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true

  uci commit openmptcprouter
  uci commit network
  uci commit glorytun-udp
  uci commit shadowsocks-rust
  uci commit omr-tracker 2>/dev/null || true

  /etc/init.d/omr-tracker restart >/dev/null 2>&1 || true
  /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
  sleep 1
  ifup omrvpn >/dev/null 2>&1 || true
  /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1 || true

  _red=false; case "$SCHED" in bpf_red|redundant) _red=true ;; esac
  ok_json optimize ",\"mode\":\"$MODE\",\"scheduler\":\"$SCHED\",\"master\":\"$MASTER\",\"host\":\"$HOST\",\"redundant\":$_red"
}

# ---------- settings (compat) ----------
set_settings() {
  VPN=$(qget vpn)
  PROXY=$(qget proxy)
  MASTER=$(qget master)
  [ -n "$VPN" ] && uci set openmptcprouter.settings.vpn="$VPN"
  [ -n "$PROXY" ] && uci set openmptcprouter.settings.proxy="$PROXY"
  [ -n "$MASTER" ] && uci set openmptcprouter.settings.master="$MASTER"
  uci commit openmptcprouter
  if [ "$VPN" = "glorytun_udp" ]; then
    uci set glorytun-udp.vpn.enable='1'; uci commit glorytun-udp
    /etc/init.d/glorytun-udp restart >/dev/null 2>&1 || true
  fi
  ok_json setsettings
}

case "$A" in
  wanup)      [ -n "$I" ] && ifup "$I" >/dev/null 2>&1;   ok_json wanup ',"i":"'"$I"'"' ;;
  wandown)    [ -n "$I" ] && ifdown "$I" >/dev/null 2>&1; ok_json wandown ',"i":"'"$I"'"' ;;
  wanrestart) [ -n "$I" ] && { ifdown "$I" >/dev/null 2>&1; sleep 1; ifup "$I" >/dev/null 2>&1; }
              ok_json wanrestart ',"i":"'"$I"'"' ;;
  vpn)        /etc/init.d/glorytun-udp restart >/dev/null 2>&1
              sleep 1
              _lip=$(uci -q get glorytun-udp.vpn.localip); [ -z "$_lip" ] && _lip=10.255.254.2
              _rpeer=$(uci -q get glorytun-udp.vpn.remoteip); [ -z "$_rpeer" ] && _rpeer=10.255.254.1
              uci set network.omrvpn.proto='static'
              uci set network.omrvpn.ipaddr="$_lip"
              uci set network.omrvpn.netmask='255.255.255.252'
              uci set network.omrvpn.gateway="$_rpeer"
              uci set network.omrvpn.device="$TUN_DEV"
              uci commit network
              ip link set "$TUN_DEV" up 2>/dev/null || true
              ip addr flush dev "$TUN_DEV" 2>/dev/null || true
              ip addr add "$_lip/30" peer "$_rpeer" dev "$TUN_DEV" 2>/dev/null || ip addr add "$_lip/30" dev "$TUN_DEV" 2>/dev/null || true
              ifup omrvpn >/dev/null 2>&1; ok_json vpn ;;
  proxy)      /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1; ok_json proxy ;;
  reconnect)  for w in $WANS; do ifup "$w" >/dev/null 2>&1; done
              /etc/init.d/glorytun-udp restart >/dev/null 2>&1; ifup omrvpn >/dev/null 2>&1
              /etc/init.d/shadowsocks-rust restart >/dev/null 2>&1; ok_json reconnect ;;
  exitip)     _e=""; _lat=""
              for _eu in "https://api.ipify.org" "http://checkip.amazonaws.com" "http://ifconfig.me/ip"; do
                _e=$(curl -4 -fsS -m 6 --socks5-hostname 127.0.0.1:1111 "$_eu" 2>/dev/null | tr -d ' \r\n\t')
                case "$_e" in *.*.*.*) break ;; *) _e="" ;; esac
              done
              _lat=$(ping_ms "$TUN_PEER")
              [ -z "$_lat" ] && _lat=$(ping_ms 1.1.1.1)
              printf '{"ok":true,"exit_ip":"%s","lat":"%s"}' "$_e" "$_lat" ;;
  version)    _r=$(ota_get VERSION 2>/dev/null | tr -d ' \r\n')
              printf '{"ok":true,"local":"%s","remote":"%s","update_available":%s}' \
                "$LOCAL_VER" "$_r" "$([ -n "$_r" ] && [ "$_r" != "$LOCAL_VER" ] && echo true || echo false)" ;;
  update)     do_update ;;
  sysinfo)    sysinfo_json ;;
  config)     config_json ;;
  setserver)  set_server ;;
  setwan)     set_wan ;;
  addwan)     add_wan_device ;;
  scanwans)   scan_wans_action ;;
  setsettings) set_settings ;;
  setvpn)     set_vpn ;;
  setproxy)   set_proxy_cfg ;;
  optimize)   optimize_stack ;;
  setlan)     set_lan ;;
  setbond)    set_bond ;;
  status|*)   status_json ;;
esac
