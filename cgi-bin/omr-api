    [ -n "$_wj" ] && _wj="$_wj,"
    _wj="$_wj{\"name\":\"$w\",\"dev\":\"$_dev\",\"proto\":\"$_proto\",\"multipath\":\"$_mp\",\"auto\":\"$_auto\",\"ip\":\"$_ip\",\"netmask\":\"$_wmask\",\"gateway\":\"$_gw\",\"dns\":\"$_dns\",\"username\":\"$_user\"}"
